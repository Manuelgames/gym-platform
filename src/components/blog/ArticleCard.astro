---
export interface Props {
  image: string;
  alt: string;
  category: string;
  title: string;
  excerpt: string;
  href?: string;
  width?: number;
  height?: number;
}

const { image, alt, category, title, excerpt, href, width, height } = Astro.props;
---

<article class:list={["article-card", { "article-card--linked": Boolean(href) }]}>
  {href ? (
    <a href={href}>
      <img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      <div class="article-card__body">
        <small>{category}</small>
        <h3>{title}</h3>
        <p>{excerpt}</p>
      </div>
    </a>
  ) : (
    <Fragment>
      <img src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
      <div class="article-card__body">
        <small>{category}</small>
        <h3>{title}</h3>
        <p>{excerpt}</p>
      </div>
    </Fragment>
  )}
</article>

<style>
  .article-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .article-card--linked:hover,
  .article-card--linked:focus-within {
    border-color: var(--color-gold);
    transform: translateY(-0.4rem);
  }

  .article-card > :global(a) {
    display: block;
    height: 100%;
  }

  .article-card :global(img) {
    width: 100%;
    height: 20rem;
    object-fit: cover;
    filter: sepia(0.25) saturate(0.8);
  }

  .article-card__body {
    padding: 2rem;
  }

  h3 {
    margin: 0 0 1rem;
    font: 700 2rem/1.15 var(--font-display);
  }

  p {
    color: var(--color-muted);
    font-size: 1.4rem;
  }

  small {
    color: var(--color-gold-light);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
