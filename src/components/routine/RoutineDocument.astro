---
import type { RoutinePlan } from '../../domain/routine/routine';
import Button from '../ui/Button.astro';

export interface Props {
  plan: RoutinePlan;
  clientName: string;
  authorName?: string;
  pdfHref?: string;
}

const { plan, clientName, authorName, pdfHref } = Astro.props;
const sourceLabel = plan.source === 'ai'
  ? plan.generationEngine === 'openai' ? 'Generada con IA' : 'Generación automática local'
  : plan.source === 'manual' ? 'Creada por ti' : 'Asignada por entrenador';
const goalLabels = {
  fuerza: 'Ganar fuerza', hipertrofia: 'Hipertrofia', perdida_grasa: 'Pérdida de grasa',
  resistencia: 'Resistencia', movilidad: 'Movilidad', general: 'Condición general',
};
const locationLabels = { gimnasio: 'Gimnasio', casa: 'Casa', mixto: 'Mixto' };
const dayLabels = { lunes: 'Lunes', martes: 'Martes', miercoles: 'Miércoles', jueves: 'Jueves', viernes: 'Viernes', sabado: 'Sábado', domingo: 'Domingo' };
const updated = new Intl.DateTimeFormat('es-MX', { dateStyle: 'long' }).format(new Date(plan.updatedAt));
const restCount = plan.days.filter((day) => day.isRestDay).length;
const totalExercises = plan.days.reduce((total, day) => total + day.exercises.length, 0);
---

<article class="routine-sheet">
  <header class="routine-sheet__masthead">
    <div>
      <div class="routine-sheet__badges"><span>{sourceLabel}</span><span>{plan.level}</span></div>
      <h2>{plan.title}</h2>
      <p>Programa semanal de entrenamiento · Lunes a domingo</p>
      <small>Actualizado el {updated}{authorName ? ` · Elaborado por ${authorName}` : ''}</small>
    </div>
    <div class="routine-sheet__mark" aria-hidden="true"><span></span><span></span><span></span></div>
    {pdfHref && <Button class="routine-sheet__download" href={pdfHref} variant="ghost" size="small">Descargar PDF</Button>}
  </header>

  {plan.summary && <p class="routine-sheet__summary">{plan.summary}</p>}

  <dl class="routine-profile">
    <div><dt>Atleta</dt><dd>{clientName}</dd></div>
    <div><dt>Objetivo</dt><dd>{goalLabels[plan.goal]}</dd></div>
    <div><dt>Nivel</dt><dd>{plan.level}</dd></div>
    <div><dt>Lugar</dt><dd>{locationLabels[plan.location]}</dd></div>
    <div><dt>Sesión</dt><dd>{plan.sessionDurationMinutes} min</dd></div>
  </dl>

  <dl class="routine-metrics">
    <div><dt>Días activos</dt><dd>{plan.days.length - restCount}</dd></div>
    <div><dt>Días de descanso</dt><dd>{restCount}</dd></div>
    <div><dt>Ejercicios semanales</dt><dd>{totalExercises}</dd></div>
    <div><dt>Equipo</dt><dd>{plan.availableEquipment || 'No especificado'}</dd></div>
  </dl>

  <div class="routine-sheet__title"><span></span><h3>Distribución semanal</h3><span></span></div>

  <section class="routine-week" aria-label="Rutina de lunes a domingo">
    {plan.days.map((day, index) => (
      <article class:list={['routine-day', { 'routine-day--rest': day.isRestDay }]}>
        <header class="routine-day__header">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><p>{dayLabels[day.day]}</p><h3>{day.title}</h3>{day.focus && <small>{day.focus}</small>}</div>
          <strong>{day.isRestDay ? 'Recuperación' : `${day.exercises.length} ejercicios`}</strong>
        </header>
        {day.isRestDay ? (
          <div class="routine-day__recovery">
            <span aria-hidden="true">Zz</span>
            <p>Descanso planificado. Prioriza sueño, hidratación y movilidad suave según tolerancia.</p>
          </div>
        ) : (
          <div class="routine-exercise-table">
            <div class="routine-exercise-table__heading" aria-hidden="true">
              <span>Ejercicio</span><span>Grupo</span><span>Series × reps</span><span>Descanso</span><span>Tempo</span>
            </div>
            {day.exercises.map((exercise, exerciseIndex) => (
              <div class="routine-exercise-row">
                <div><span>{String(exerciseIndex + 1).padStart(2, '0')}</span><strong>{exercise.name}</strong>{exercise.notes && <small>{exercise.notes}</small>}</div>
                <p data-label="Grupo">{exercise.muscle}</p>
                <p data-label="Series × reps"><strong>{exercise.sets} × {exercise.reps}</strong></p>
                <p data-label="Descanso">{exercise.restSeconds ? `${exercise.restSeconds} s` : 'Sin pausa'}</p>
                <p data-label="Tempo">{exercise.tempo || 'Controlado'}</p>
              </div>
            ))}
          </div>
        )}
      </article>
    ))}
  </section>

  <section class="routine-sheet__notes">
    <article><h3>Preparación</h3><ul><li>Realiza calentamiento progresivo antes de las series efectivas.</li><li>Conserva la técnica antes de aumentar carga o repeticiones.</li><li>Registra sensaciones para ajustar la siguiente semana.</li></ul></article>
    <article><h3>Consideraciones</h3><p>{plan.limitations || 'No se registraron limitaciones específicas para este plan.'}</p><small>Suspende el ejercicio ante dolor agudo, mareo o malestar inusual y solicita valoración profesional.</small></article>
  </section>

  <footer><span>RC</span><p>Plan educativo de entrenamiento. No sustituye una valoración médica, fisioterapéutica o profesional individual.</p></footer>
</article>

<style>
  .routine-sheet { --sheet-blue: #123c66; --sheet-blue-mid: #28629b; --sheet-red: #a33232; --sheet-line: #c9d5df; display: grid; gap: 1.5rem; width: 100%; padding: clamp(2rem, 5vw, 4.4rem); border: 1px solid #d8e0e6; border-radius: 1.2rem; background: linear-gradient(135deg, rgb(248 251 253 / 98%), rgb(255 255 255 / 98%)); box-shadow: 0 2.5rem 6rem rgb(0 0 0 / 24%); color: #18232d; }
  .routine-sheet__masthead { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; padding-right: 7rem; }
  .routine-sheet__badges { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: .8rem; }
  .routine-sheet__badges span { padding: .4rem .75rem; border: 1px solid #9bb3c8; border-radius: 99rem; color: var(--sheet-blue-mid); font-size: .95rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .routine-sheet h2 { margin: 0; color: var(--sheet-blue); font: 800 clamp(2.7rem, 5vw, 4.5rem)/1.04 var(--font-display); letter-spacing: -.025em; }
  .routine-sheet__masthead p { margin: .7rem 0 .2rem; color: #4c5964; font-size: 1.45rem; font-style: italic; }
  .routine-sheet__masthead small { color: #66737d; }
  .routine-sheet__mark { position: absolute; top: .2rem; right: 0; display: flex; align-items: center; gap: .5rem; height: 5rem; }
  .routine-sheet__mark span { display: block; width: 1.2rem; height: 3rem; border-radius: .4rem; background: var(--sheet-red); }
  .routine-sheet__mark span:nth-child(2) { width: 2.4rem; height: .7rem; }
  :global(.routine-sheet__download.button) { grid-column: 2; margin-top: 5.4rem; border-color: #8ba8c0; background: #fff; color: var(--sheet-blue); }
  .routine-sheet__summary { margin: 0; padding: 1.2rem 1.4rem; border-left: .35rem solid var(--sheet-red); background: #f3f6f8; color: #44515b; font-size: 1.3rem; }
  .routine-profile { display: grid; grid-template-columns: 1.3fr repeat(4, 1fr); margin: 0; overflow: hidden; border: 1px solid #8faac0; border-radius: 1rem; }
  .routine-profile > div { min-width: 0; padding: 1.2rem 1rem; border-right: 1px solid #d8e0e6; text-align: center; }
  .routine-profile > div:last-child { border-right: 0; }
  .routine-profile dt, .routine-metrics dt { color: var(--sheet-blue-mid); font-size: 1rem; font-weight: 900; letter-spacing: .05em; text-transform: uppercase; }
  .routine-profile dd { margin: .3rem 0 0; color: #172633; font-size: 1.25rem; font-weight: 750; text-transform: capitalize; overflow-wrap: anywhere; }
  .routine-metrics { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; overflow: hidden; border: 1px solid #d6dee4; background: #f5f8fa; }
  .routine-metrics > div { padding: 1rem 1.2rem; border-right: 1px solid #d6dee4; }
  .routine-metrics > div:last-child { border-right: 0; }
  .routine-metrics dd { margin: .25rem 0 0; color: var(--sheet-blue); font-size: 1.4rem; font-weight: 900; overflow-wrap: anywhere; }
  .routine-sheet__title { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; }
  .routine-sheet__title span { height: 1px; background: var(--sheet-blue-mid); }
  .routine-sheet__title h3 { margin: 0; color: var(--sheet-blue); font: 800 2.3rem var(--font-display); }
  .routine-week { display: grid; gap: 1rem; }
  .routine-day { overflow: hidden; border: 1px solid #bdcbd6; border-radius: .8rem; background: #fff; }
  .routine-day--rest { border-color: #a9bfaa; background: #f5f8f2; }
  .routine-day__header { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.2rem; padding: 1.1rem 1.3rem; background: #edf3f7; }
  .routine-day--rest .routine-day__header { background: #eaf2e6; }
  .routine-day__header > span { display: grid; width: 3.5rem; height: 3.5rem; place-items: center; border-radius: 50%; background: var(--sheet-blue); color: #fff; font-weight: 900; }
  .routine-day--rest .routine-day__header > span { background: #4b7744; }
  .routine-day__header p { margin: 0; color: var(--sheet-blue-mid); font-size: 1rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .routine-day__header h3 { margin: .15rem 0; color: #182b3a; font: 800 1.8rem var(--font-display); }
  .routine-day__header small { color: #62717c; }
  .routine-day__header > strong { color: var(--sheet-red); font-size: 1rem; letter-spacing: .07em; text-transform: uppercase; }
  .routine-day--rest .routine-day__header > strong { color: #4b7744; }
  .routine-exercise-table__heading, .routine-exercise-row { display: grid; grid-template-columns: minmax(22rem, 1.8fr) .7fr .8fr .65fr .65fr; align-items: center; gap: 1rem; }
  .routine-exercise-table__heading { padding: .8rem 1.2rem; border-top: 1px solid #d3dee6; border-bottom: 1px solid #d3dee6; background: #f8fafb; color: #667785; font-size: .9rem; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .routine-exercise-row { min-height: 5.5rem; padding: .9rem 1.2rem; border-bottom: 1px solid #e3e8ec; }
  .routine-exercise-row:last-child { border-bottom: 0; }
  .routine-exercise-row > div { display: grid; grid-template-columns: auto 1fr; column-gap: .8rem; }
  .routine-exercise-row > div > span { grid-row: 1 / 3; color: var(--sheet-red); font-weight: 900; }
  .routine-exercise-row strong { color: #172633; }
  .routine-exercise-row small { color: #697680; line-height: 1.35; }
  .routine-exercise-row p { margin: 0; color: #3e4e5a; }
  .routine-day__recovery { display: flex; align-items: center; gap: 1rem; padding: 1.4rem; }
  .routine-day__recovery span { display: grid; width: 4rem; height: 4rem; place-items: center; border-radius: 50%; background: #dbe9d4; color: #41693c; font-weight: 900; }
  .routine-day__recovery p { margin: 0; color: #536550; }
  .routine-sheet__notes { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .routine-sheet__notes article { padding: 1.4rem; border: 1px solid #c9d5df; background: #f7f9fa; }
  .routine-sheet__notes h3 { margin: 0 0 .8rem; color: var(--sheet-blue); font: 800 1.8rem var(--font-display); }
  .routine-sheet__notes ul, .routine-sheet__notes p { margin: 0; color: #475761; }
  .routine-sheet__notes small { display: block; margin-top: .8rem; color: var(--sheet-red); }
  .routine-sheet footer { display: flex; align-items: center; justify-content: center; gap: 1rem; padding-top: 1rem; border-top: 2px solid var(--sheet-blue-mid); text-align: center; }
  .routine-sheet footer span { display: grid; width: 3.2rem; height: 3.2rem; place-items: center; border-radius: 50%; background: var(--sheet-blue); color: #fff; font-weight: 900; }
  .routine-sheet footer p { margin: 0; color: #65727b; font-size: 1rem; font-style: italic; }
  @media (max-width: 900px) {
    .routine-profile { grid-template-columns: repeat(3, 1fr); }
    .routine-profile > div { border-bottom: 1px solid #d8e0e6; }
    .routine-exercise-table__heading { display: none; }
    .routine-exercise-row { grid-template-columns: 1fr 1fr; }
    .routine-exercise-row > div { grid-column: 1 / -1; }
    .routine-exercise-row p::before { content: attr(data-label) ': '; color: #72808a; font-size: .85em; font-weight: 800; text-transform: uppercase; }
  }
  @media (max-width: 650px) {
    .routine-sheet__masthead { grid-template-columns: 1fr; padding-right: 5rem; }
    :global(.routine-sheet__download.button) { grid-column: 1; width: fit-content; margin-top: 0; }
    .routine-profile, .routine-metrics, .routine-sheet__notes { grid-template-columns: 1fr 1fr; }
    .routine-day__header { grid-template-columns: auto 1fr; }
    .routine-day__header > strong { grid-column: 2; }
  }
  @media (max-width: 440px) {
    .routine-sheet { margin-inline: -.8rem; padding: 1.3rem; border-radius: .5rem; }
    .routine-profile, .routine-metrics, .routine-sheet__notes, .routine-exercise-row { grid-template-columns: 1fr; }
  }
</style>
