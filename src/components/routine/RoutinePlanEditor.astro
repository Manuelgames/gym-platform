---
import {
  MUSCLE_GROUPS,
  ROUTINE_PLAN_DAYS,
  ROUTINE_SESSION_DURATION_OPTIONS,
  type RoutinePlan,
  type RoutinePlanDay,
  type RoutinePlanDayName,
} from '../../domain/routine/routine';
import Button from '../ui/Button.astro';

export interface Props {
  id: string;
  action: string;
  plan?: RoutinePlan | null;
  requestId?: string;
  submitLabel?: string;
}

const { id, action, plan = null, requestId, submitLabel = 'Guardar rutina completa' } = Astro.props;
const selectedDuration = plan?.sessionDurationMinutes ?? 60;
const durationOptions = ROUTINE_SESSION_DURATION_OPTIONS.includes(selectedDuration as never)
  ? [...ROUTINE_SESSION_DURATION_OPTIONS]
  : [...ROUTINE_SESSION_DURATION_OPTIONS, selectedDuration].sort((left, right) => left - right);
const durationOptionLabel = (minutes: number) => `${String(Math.floor(minutes / 60)).padStart(2, '0')} h ${String(minutes % 60).padStart(2, '0')} min`;
const exerciseDurationOptions = [5, 10, 15, 20, 25, 30, 40, 45, 60];
const exerciseDurationChoices = (selected: number) => exerciseDurationOptions.includes(selected)
  ? exerciseDurationOptions
  : [...exerciseDurationOptions, selected].sort((left, right) => left - right);
const dayShortLabels: Record<RoutinePlanDayName, string> = {
  lunes: 'Lun', martes: 'Mar', miercoles: 'Mié', jueves: 'Jue', viernes: 'Vie', sabado: 'Sáb', domingo: 'Dom',
};
const defaultDays: RoutinePlanDay[] = ROUTINE_PLAN_DAYS.map((day, index) => ({
  day,
  title: index === 0 ? 'Entrenamiento de cuerpo completo' : 'Sesión de entrenamiento',
  focus: '',
  isRestDay: false,
  exercises: [{
    name: '', muscle: 'Pecho', prescriptionType: 'repetitions', sets: 3, reps: '8-12', durationMinutes: null, restSeconds: 90, tempo: '', notes: '',
  }],
}));
const days = plan?.days.length ? plan.days : defaultDays;
---

<form id={id} class="routine-editor" action={action} method="post" data-routine-editor>
  {requestId && <input type="hidden" name="requestId" value={requestId} />}
  <input type="hidden" name="days" value={JSON.stringify(days)} data-routine-days />

  <nav class="routine-editor__tabs" aria-label="Secciones de la rutina" role="tablist">
    <button class="is-active" type="button" role="tab" aria-selected="true" aria-controls={`${id}-general`} data-editor-tab="general">Parámetros generales</button>
    <button type="button" role="tab" aria-selected="false" aria-controls={`${id}-week`} data-editor-tab="week">Semana</button>
  </nav>

  <section id={`${id}-general`} class="routine-editor__panel" role="tabpanel" data-editor-panel="general">
    <div class="routine-editor__grid routine-editor__grid--two">
      <label><span>Título de la rutina *</span><input name="title" required minlength="2" maxlength="120" value={plan?.title ?? 'Mi rutina semanal'} /></label>
      <label>
        <span>Objetivo *</span>
        <select name="goal" required>
          <option value="fuerza" selected={plan?.goal === 'fuerza'}>Ganar fuerza</option>
          <option value="hipertrofia" selected={plan?.goal === 'hipertrofia'}>Hipertrofia / masa muscular</option>
          <option value="perdida_grasa" selected={plan?.goal === 'perdida_grasa'}>Pérdida de grasa</option>
          <option value="resistencia" selected={plan?.goal === 'resistencia'}>Resistencia</option>
          <option value="movilidad" selected={plan?.goal === 'movilidad'}>Movilidad</option>
          <option value="general" selected={!plan || plan.goal === 'general'}>Condición física general</option>
        </select>
      </label>
      <label>
        <span>Nivel *</span>
        <select name="level" required>
          <option value="principiante" selected={!plan || plan.level === 'principiante'}>Principiante</option>
          <option value="intermedio" selected={plan?.level === 'intermedio'}>Intermedio</option>
          <option value="avanzado" selected={plan?.level === 'avanzado'}>Avanzado</option>
        </select>
      </label>
      <label>
        <span>Lugar *</span>
        <select name="location" required>
          <option value="gimnasio" selected={!plan || plan.location === 'gimnasio'}>Gimnasio</option>
          <option value="casa" selected={plan?.location === 'casa'}>Casa</option>
          <option value="mixto" selected={plan?.location === 'mixto'}>Mixto</option>
        </select>
      </label>
      <label><span>Duración por sesión *</span><select name="sessionDurationMinutes" required>{durationOptions.map((minutes) => <option value={minutes} selected={minutes === selectedDuration}>{durationOptionLabel(minutes)}</option>)}</select></label>
      <label class="routine-editor__wide"><span>Descripción general</span><textarea name="summary" maxlength="900" rows="3" placeholder="Propósito, progresión o indicaciones de la semana.">{plan?.summary ?? ''}</textarea></label>
    </div>
  </section>

  <section id={`${id}-week`} class="routine-editor__panel" role="tabpanel" data-editor-panel="week" hidden>
    <p class="routine-week-selector__help">Selecciona un día para configurar el descanso y el orden de sus ejercicios.</p>
    <div class="routine-week-selector__viewport" role="region" aria-label="Días de la semana" tabindex="0">
      <div class="routine-week-selector">
        {days.map((day) => (
          <button type="button" class:list={['routine-week-selector__day', { 'is-rest-day': day.isRestDay }]} data-open-routine-day={day.day}>
            <strong>{dayShortLabels[day.day]}</strong>
            <span data-week-day-status>{day.isRestDay ? 'Descanso' : `${day.exercises.length} ejercicio${day.exercises.length === 1 ? '' : 's'}`}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="routine-day-modal" role="dialog" aria-modal="false" aria-label="Editor del día" data-day-editor-overlay hidden>
    <header class="routine-day-modal__header">
      <button type="button" class="routine-action routine-action--back" data-close-routine-day>← Volver a la semana</button>
      <div><span data-active-day-kicker>Sesión semanal</span><h3 data-active-day-title>Día</h3></div>
    </header>
    <div class="routine-day-modal__content">
      {days.map((day) => (
        <article class:list={['routine-day-editor', { 'is-rest-day': day.isRestDay }]} data-routine-day data-day={day.day} hidden>
          <div class="routine-day-editor__settings">
            <label class="rest-toggle"><input type="checkbox" checked={day.isRestDay} data-day-rest /><span>Día de descanso</span></label>
            <label><span>Título del día *</span><input required maxlength="100" value={day.title} data-day-title /></label>
            <label><span>Enfoque o indicaciones</span><textarea maxlength="160" rows="2" data-day-focus>{day.focus}</textarea></label>
          </div>
          <div class="routine-day-editor__exercises" data-day-exercises hidden={day.isRestDay}>
            <div class="routine-day-editor__toolbar">
              <div><h4>Ejercicios</h4><p>Usa el nombre o las flechas para cambiar el orden.</p></div>
              <button type="button" class="routine-action routine-action--gold" data-add-routine-exercise>+ Agregar ejercicio</button>
            </div>
            <div class="routine-exercise-list" data-exercise-rows>
              {day.exercises.map((exercise, exerciseIndex) => (
                <article class="routine-exercise-editor" data-routine-exercise>
                  <header class="routine-exercise-editor__header">
                    <button type="button" class="routine-exercise-editor__toggle" data-toggle-routine-exercise aria-expanded="false" aria-label={`Mostrar ${exercise.name || `ejercicio ${exerciseIndex + 1}`}`}>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.75" /></svg>
                    </button>
                    <strong draggable="true" data-exercise-drag-handle data-exercise-label>{exercise.name || `Ejercicio ${exerciseIndex + 1}`}</strong>
                    <div>
                      <button type="button" data-move-exercise="up" aria-label="Subir ejercicio">↑</button>
                      <button type="button" data-move-exercise="down" aria-label="Bajar ejercicio">↓</button>
                      <button type="button" class="routine-action--danger" data-remove-routine-exercise aria-label={`Eliminar ${exercise.name || 'ejercicio'}`}>Eliminar</button>
                    </div>
                  </header>
                  <div class="routine-exercise-editor__fields" data-exercise-fields hidden>
                    <label class="routine-exercise-editor__name"><span>Ejercicio *</span><input required maxlength="100" value={exercise.name} data-exercise-field="name" placeholder="Ej. Press con barra" /></label>
                    <label><span>Grupo *</span><select required data-exercise-field="muscle">{MUSCLE_GROUPS.map((muscle) => <option value={muscle} selected={exercise.muscle === muscle}>{muscle}</option>)}</select></label>
                    <label><span>Prescripción *</span><select required data-exercise-field="prescriptionType"><option value="repetitions" selected={exercise.prescriptionType === 'repetitions'}>Series y reps</option><option value="duration" selected={exercise.prescriptionType === 'duration'}>Por tiempo</option></select></label>
                    <label data-repetition-field hidden={exercise.prescriptionType === 'duration'}><span>Series *</span><input required={exercise.prescriptionType === 'repetitions'} type="number" min="1" max="30" value={exercise.sets ?? 3} data-exercise-field="sets" /></label>
                    <label data-repetition-field hidden={exercise.prescriptionType === 'duration'}><span>Repeticiones *</span><input required={exercise.prescriptionType === 'repetitions'} maxlength="30" value={exercise.reps} data-exercise-field="reps" placeholder="8-12" /></label>
                    <label data-duration-field hidden={exercise.prescriptionType !== 'duration'}><span>Duración *</span><select required={exercise.prescriptionType === 'duration'} data-exercise-field="durationMinutes">{exerciseDurationChoices(exercise.durationMinutes ?? 15).map((minutes) => <option value={minutes} selected={(exercise.durationMinutes ?? 15) === minutes}>{minutes} min</option>)}</select></label>
                    <label><span>Pausa posterior (s) *</span><input required type="number" min="0" max="900" step="5" value={exercise.restSeconds} data-exercise-field="restSeconds" /></label>
                    <label><span>Tempo / ritmo</span><input maxlength="30" value={exercise.tempo} data-exercise-field="tempo" placeholder={exercise.prescriptionType === 'duration' ? 'Ritmo moderado' : '3-1-1'} /></label>
                    <label class="routine-exercise-editor__notes"><span>Notas técnicas</span><textarea maxlength="300" rows="2" data-exercise-field="notes" placeholder="Técnica, intensidad o alternativa.">{exercise.notes}</textarea></label>
                  </div>
                </article>
              ))}
            </div>
          </div>
          <div class="routine-day-editor__save"><button type="button" class="routine-action routine-action--gold" data-save-routine-day>Guardar rutina y volver</button></div>
        </article>
      ))}
    </div>
  </section>

  <div class="routine-editor__submit">
    <Button type="submit">{submitLabel}</Button>
  </div>

  <template data-routine-exercise-template>
    <article class="routine-exercise-editor is-new is-expanded" data-routine-exercise>
      <header class="routine-exercise-editor__header">
        <button type="button" class="routine-exercise-editor__toggle" data-toggle-routine-exercise aria-expanded="true" aria-label="Ocultar nuevo ejercicio">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.75" /></svg>
        </button>
        <strong draggable="true" data-exercise-drag-handle data-exercise-label>Nuevo ejercicio</strong>
        <div>
          <button type="button" data-move-exercise="up" aria-label="Subir ejercicio">↑</button>
          <button type="button" data-move-exercise="down" aria-label="Bajar ejercicio">↓</button>
          <button type="button" class="routine-action--danger" data-remove-routine-exercise>Eliminar</button>
        </div>
      </header>
      <div class="routine-exercise-editor__fields" data-exercise-fields>
        <label class="routine-exercise-editor__name"><span>Ejercicio *</span><input required maxlength="100" data-exercise-field="name" placeholder="Ej. Sentadilla" /></label>
        <label><span>Grupo *</span><select required data-exercise-field="muscle">{MUSCLE_GROUPS.map((muscle) => <option value={muscle}>{muscle}</option>)}</select></label>
        <label><span>Prescripción *</span><select required data-exercise-field="prescriptionType"><option value="repetitions">Series y reps</option><option value="duration">Por tiempo</option></select></label>
        <label data-repetition-field><span>Series *</span><input required type="number" min="1" max="30" value="3" data-exercise-field="sets" /></label>
        <label data-repetition-field><span>Repeticiones *</span><input required maxlength="30" value="8-12" data-exercise-field="reps" /></label>
        <label data-duration-field hidden><span>Duración *</span><select data-exercise-field="durationMinutes">{exerciseDurationOptions.map((minutes) => <option value={minutes} selected={minutes === 15}>{minutes} min</option>)}</select></label>
        <label><span>Pausa posterior (s) *</span><input required type="number" min="0" max="900" step="5" value="90" data-exercise-field="restSeconds" /></label>
        <label><span>Tempo / ritmo</span><input maxlength="30" data-exercise-field="tempo" placeholder="Controlado" /></label>
        <label class="routine-exercise-editor__notes"><span>Notas técnicas</span><textarea maxlength="300" rows="2" data-exercise-field="notes"></textarea></label>
      </div>
    </article>
  </template>
</form>

<script>
  import '../../scripts/routine-editor';
</script>

<style>
  .routine-editor { display: grid; min-width: 0; max-width: 100%; gap: 1.6rem; }
  .routine-editor__tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; padding: .8rem;  }
  .routine-editor__tabs button { min-width: 0; min-height: 4.8rem; padding: .9rem 1.2rem; border: 1px solid var(--color-line); border-radius: 1.2rem; background: rgb(9 15 11 / 62%); color: var(--color-paper); overflow-wrap: anywhere; font-size: 1.1rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .routine-editor__tabs button.is-active { border-color: var(--color-gold); background: rgb(214 166 66 / 13%); color: var(--color-gold-light); }
  .routine-editor__panel { min-width: 0; max-width: 100%; padding: clamp(1.5rem, 3vw, 2.4rem); background: linear-gradient(145deg, rgb(34 45 39 / 94%), rgb(15 23 18 / 98%)); }
  .routine-editor__panel[hidden], .routine-day-modal[hidden], .routine-day-editor[hidden] { display: none; }
  .routine-editor__grid { display: grid; gap: 1.3rem; }
  .routine-editor__grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .routine-editor__wide { grid-column: 1 / -1; }
  label { display: grid; align-content: start; gap: .6rem; min-width: 0; }
  label > span { color: var(--color-muted); font-size: 1.02rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  input, select, textarea { width: 100%; min-height: 4.5rem; padding: .9rem 1rem; border: 1px solid #586057; border-radius: 0; background: #0f1712; color: var(--color-paper); outline: 0; }
  textarea { resize: vertical; }
  input:focus, select:focus, textarea:focus { border-color: var(--color-gold); box-shadow: var(--shadow-focus); }
  .routine-week-selector__viewport { width: 100%; min-width: 0; max-width: 100%; overflow-x: auto; overflow-y: hidden; overscroll-behavior-inline: contain; scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
  .routine-week-selector { display: flex; flex-wrap: nowrap; width: max-content; min-width: 100%; gap: .8rem; padding: .2rem .1rem .8rem; }
  .routine-week-selector__day { display: grid; flex: 1 0 8.5rem; gap: .5rem; min-width: 8.5rem; min-height: 8rem; place-content: center; padding: .9rem .5rem; border: 1px solid var(--color-gold); border-radius: 1.2rem; background: rgb(214 166 66 / 9%); color: var(--color-paper); text-align: center; }
  .routine-week-selector__day:hover { background: rgb(214 166 66 / 16%); }
  .routine-week-selector__day.is-rest-day { border-color: rgb(152 207 154 / 45%); background: rgb(152 207 154 / 7%); }
  .routine-week-selector__day strong { color: var(--color-gold-light); font: 700 1.7rem var(--font-display); }
  .routine-week-selector__day span { color: var(--color-muted); font-size: .95rem; line-height: 1.2; }
  .routine-week-selector__help { margin: 0 0 1.4rem; padding: 1.4rem; color: var(--color-muted); text-align: center; }
  .routine-day-modal { border: 1px solid var(--color-line); background: #111a15; box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 35%); }
  .routine-day-modal__header { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.5rem; padding: 1.4rem; border-bottom: 1px solid var(--color-line); background: rgb(214 166 66 / 7%); }
  .routine-day-modal__header div { text-align: right; }
  .routine-day-modal__header span { color: var(--color-gold); font-size: .95rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .routine-day-modal__header h3 { margin: .2rem 0 0; font: 700 2.3rem var(--font-display); }
  .routine-day-modal__content { padding: clamp(1rem, 2.5vw, 2rem); border: none; }
  .routine-day-editor__settings { display: grid; grid-template-columns: minmax(16rem, .55fr) 1fr 1.4fr; align-items: end; gap: 1.2rem; }
  .rest-toggle { align-content: center; min-height: 4.5rem; grid-template-columns: auto 1fr; align-items: center; padding: .8rem 1rem; border: 1px solid var(--color-line-soft); }
  .rest-toggle input { width: 1.8rem; min-height: 1.8rem; accent-color: var(--color-gold); }
  .rest-toggle span { color: var(--color-paper); }
  .routine-day-editor__exercises { margin-top: 1.6rem; padding-top: 1.6rem; border-top: 1px solid var(--color-line-soft); }
  .routine-day-editor__exercises[hidden] { display: none; }
  .routine-day-editor__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.2rem; }
  .routine-day-editor__toolbar h4 { margin: 0; font: 700 1.8rem var(--font-display); }
  .routine-day-editor__toolbar p { margin: .3rem 0 0; color: var(--color-muted); font-size: 1.05rem; }
  .routine-exercise-list { display: grid; gap: 1.1rem; }
  .routine-exercise-editor { display: grid; gap: 1rem; padding: 1.2rem; border: 1px solid var(--color-line-soft); background: rgb(255 255 255 / 2%); }
  .routine-exercise-editor.is-dragging { border-color: var(--color-gold); opacity: .55; }
  .routine-exercise-editor.is-expanded { border-color: rgb(214 166 66 / 42%); }
  .routine-exercise-editor__header { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .8rem; }
  .routine-exercise-editor__header > div { display: flex; gap: .4rem; }
  .routine-exercise-editor__header button { min-width: 3.5rem; min-height: 3.5rem; padding: .4rem .7rem; border: 1px solid var(--color-line); background: transparent; color: var(--color-paper); }
  .routine-exercise-editor__toggle { color: var(--color-gold-light) !important; }
  .routine-exercise-editor__toggle svg { width: 2rem; height: 2rem; fill: none; stroke: currentColor; stroke-width: 1.7; }
  .routine-exercise-editor.is-expanded .routine-exercise-editor__toggle { border-color: var(--color-gold); background: rgb(214 166 66 / 9%); }
  .routine-exercise-editor__header > strong { cursor: grab; touch-action: none; }
  .routine-exercise-editor__fields { display: grid; grid-template-columns: minmax(16rem, 1.5fr) repeat(2, minmax(11rem, .8fr)) repeat(4, minmax(8rem, .55fr)); align-items: end; gap: .8rem; }
  .routine-exercise-editor__fields[hidden] { display: none; }
  .routine-exercise-editor__notes { grid-column: 1 / -1; }
  .routine-exercise-editor input, .routine-exercise-editor select { min-height: 4rem; padding: .7rem .8rem; }
  .routine-action { min-height: 3.8rem; padding: .6rem 1rem; border: 1px solid var(--color-line); background: transparent; color: var(--color-gold-light); font-size: 1rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .routine-action--gold { border-color: var(--color-gold); background: linear-gradient(135deg, #edcf70, #b87d20); color: #171208; }
  .routine-action--danger { border-color: rgb(242 139 121 / 38%) !important; color: var(--color-danger) !important; }
  .routine-day-editor__save { display: flex; justify-content: flex-end; margin-top: 1.6rem; }
  .routine-editor__submit { display: flex; justify-content: center; padding-top: .4rem; }
  @media (max-width: 900px) {
    .routine-exercise-editor__fields { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .routine-editor__grid--two, .routine-day-editor__settings { grid-template-columns: 1fr; }
    .routine-editor__wide { grid-column: auto; }
    .routine-exercise-editor__fields { grid-template-columns: 1fr 1fr; }
    .routine-exercise-editor__name, .routine-exercise-editor__notes { grid-column: 1 / -1; }
    .routine-day-editor__toolbar { align-items: stretch; flex-direction: column; }
    .routine-day-modal__header { grid-template-columns: 1fr; }
    .routine-day-modal__header div { text-align: left; }
  }
  @media (max-width: 480px) {
    .routine-editor__tabs { grid-template-columns: 1fr; }
    .routine-exercise-editor__fields { grid-template-columns: 1fr; }
    .routine-exercise-editor__name, .routine-exercise-editor__notes { grid-column: auto; }
    .routine-exercise-editor__header { grid-template-columns: auto 1fr; }
    .routine-exercise-editor__header > div { grid-column: 1 / -1; }
    .routine-day-editor__save, .routine-editor__submit { display: grid; }
  }
</style>
