---
import Button from "../ui/Button.astro";

export interface Props {
  numeral: string;
  title: string;
  description: string;
  href: string;
  actionLabel: string;
}

const { numeral, title, description, href, actionLabel } = Astro.props;
---

<article class="module-card">
  <span class="module-card__number" aria-hidden="true">{numeral}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <Button href={href} size="small">{actionLabel}</Button>
</article>

<style>
  .module-card {
    display: flex;
    min-height: 22rem;
    flex-direction: column;
    padding: 2.4rem;
    border: 1px solid var(--color-line);
    background: linear-gradient(145deg, rgb(38 49 43 / 96%), rgb(19 27 23 / 98%));
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .module-card:hover,
  .module-card:focus-within {
    border-color: var(--color-gold);
    transform: translateY(-0.4rem);
  }

  .module-card__number {
    color: var(--color-gold);
    font: 700 2.6rem var(--font-display);
  }

  h3 {
    margin: 2rem 0 0.7rem;
    font: 700 2.3rem var(--font-display);
  }

  p {
    margin: 0 0 2rem;
    color: var(--color-muted);
  }

  .module-card :global(.button) {
    align-self: start;
    margin-top: auto;
  }
</style>
