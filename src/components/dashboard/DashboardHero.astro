---
import StatCard from "../ui/StatCard.astro";

export interface DashboardStat {
  value: string | number;
  label: string;
}

export interface Props {
  name: string;
  eyebrow?: string;
  lead: string;
  summaryTitle?: string;
  summary?: string;
  stats?: DashboardStat[];
}

const {
  name,
  lead,
  summaryTitle = "Disciplina antes que gloria.",
  summary = "Los pequeños actos repetidos son el mapa para cruzar cualquier mar.",
  stats = [],
} = Astro.props;
const firstName = name.trim().split(/\s+/)[0] || "guerrero";
---

<section class="dashboard-hero" aria-labelledby="dashboard-greeting">
  <div class="dashboard-hero__copy">
    <h1 class="display-title" id="dashboard-greeting">Construye, {firstName}.</h1>
    <p class="lead">{lead}</p>
    {Astro.slots.has("actions") && <div class="dashboard-hero__actions"><slot name="actions" /></div>}
  </div>
  <aside class="today-card" aria-label="Resumen de tu jornada">
    <div>
      <p class="eyebrow">Tu jornada</p>
      <h2>{summaryTitle}</h2>
      <p>{summary}</p>
    </div>
    {stats.length > 0 && (
      <div class="today-card__stats">
        {stats.map((stat) => <StatCard value={stat.value} label={stat.label} />)}
      </div>
    )}
  </aside>
</section>

<style>
  .dashboard-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(32rem, 0.7fr);
    gap: 2rem;
    align-items: stretch;
  }

  .dashboard-hero__copy {
    padding: 4.5rem;
    border: 1px solid var(--color-line);
    background:
      linear-gradient(130deg, rgb(49 57 39 / 84%), rgb(16 23 18 / 95%)),
      url("/assets/fondoApp.jpg") center / cover;
  }

  .dashboard-hero__copy :global(.display-title) {
    max-width: 62rem;
  }

  .dashboard-hero__copy > .eyebrow {
    margin-bottom: 1.8rem;
  }

  .dashboard-hero__copy > :global(.lead) {
    max-width: 58rem;
    margin: 2.2rem 0 0;
  }

  .dashboard-hero__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
    max-width: 52rem;
    margin-top: 3.4rem;
  }

  .dashboard-hero__actions :global(.button) {
    width: 100%;
  }

  .dashboard-hero__actions :global(.dashboard-action) {
    justify-content: flex-start;
    gap: 1rem;
    text-align: left;
  }

  .dashboard-hero__actions :global(.dashboard-action__icon) {
    flex: 0 0 auto;
    width: 2.2rem;
    height: 2.2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .today-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 4rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .today-card h2 {
    margin: 0;
    font: 700 2.7rem/1.1 var(--font-display);
  }

  .today-card > div:first-child {
    display: grid;
    gap: 1.2rem;
  }

  .today-card p {
    margin: 0;
    color: var(--color-muted);
  }

  .today-card__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
    margin-top: 0;
  }

  @media (max-width: 900px) {
    .dashboard-hero {
      grid-template-columns: 1fr;
    }

    .dashboard-hero__copy,
    .today-card {
      min-height: 100svh;
      box-sizing: border-box;
      padding: clamp(3.2rem, 8vw, 5.2rem);
    }

    .dashboard-hero__copy {
      justify-content: center;
    }

    .today-card {
      justify-content: center;
      gap: 3.6rem;
    }

    .dashboard-hero__actions {
      grid-template-columns: 1fr;
      max-width: none;
    }

    .dashboard-hero__actions :global(.button) {
      min-height: 5.6rem;
    }
  }

  @media (max-width: 450px) {
    .dashboard-hero__copy,
    .today-card {
      padding: 2.8rem;
    }

    .dashboard-hero__copy {
      min-height: auto;
    }
  }
</style>
