---
export interface Props {
  label?: string;
}

const { label = "Cargando" } = Astro.props;
---

<div class="loading-state" role="status" aria-live="polite">
  <span class="loading-state__mark" aria-hidden="true"></span>
  <span>{label}</span>
</div>

<style>
  .loading-state {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-muted);
  }

  .loading-state__mark {
    width: 1.8rem;
    height: 1.8rem;
    border: 0.2rem solid var(--color-line);
    border-top-color: var(--color-gold-light);
    border-radius: 50%;
    animation: turn 800ms linear infinite;
  }

  @keyframes turn {
    to { transform: rotate(360deg); }
  }
</style>
