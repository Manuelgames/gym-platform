---
export interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
}

const { eyebrow, title, id } = Astro.props;
---

<header class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="section-title" id={id}>{title}</h2>
  </div>
  {Astro.slots.has("actions") && <div class="section-heading__actions"><slot name="actions" /></div>}
</header>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.3rem;
  }

  .section-heading__actions {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 560px) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
