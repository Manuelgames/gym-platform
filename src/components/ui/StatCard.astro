---
export interface Props {
  value: string | number;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="stat-card">
  <strong>{value}</strong>
  <span>{label}</span>
</div>

<style>
  .stat-card {
    min-width: 0;
    padding: 1.8rem 2rem;
    border: 1px solid var(--color-line);
    background: rgb(10 16 12 / 30%);
  }

  strong {
    display: block;
    color: var(--color-gold-light);
    font: 700 clamp(2.2rem, 4vw, 2.7rem) var(--font-display);
  }

  span {
    display: block;
    color: var(--color-muted);
    font-size: 1.2rem;
  }
</style>
