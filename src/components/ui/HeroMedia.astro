---
export interface Props {
  image: string;
  alt: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  variant?: "primary" | "compact";
  headingLevel?: "h1" | "h2";
  priority?: boolean;
  width?: number;
  height?: number;
  imagePosition?: string;
  class?: string;
}

const {
  image,
  alt,
  eyebrow,
  title,
  lead,
  variant = "primary",
  headingLevel = "h1",
  priority = false,
  width,
  height,
  imagePosition = "center",
  class: className = "",
} = Astro.props;
const Heading = headingLevel;
---

<section class:list={["hero-media", `hero-media--${variant}`, className]}>
  <img
    src={image}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    style={`object-position: ${imagePosition}`}
  />
  <div class="hero-media__content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading class="display-title">{title}</Heading>
    {lead && <p class="lead">{lead}</p>}
    {Astro.slots.has("actions") && <div class="hero-media__actions"><slot name="actions" /></div>}
  </div>
</section>

<style>
  .hero-media {
    position: relative;
    display: flex;
    min-height: 55rem;
    align-items: end;
    margin: 20px 0;
    isolation: isolate;
    overflow: hidden;
    padding: 5rem var(--page-gutter);
    border: 1px solid var(--color-line);
    background: #151d18;
  }

  .hero-media--compact {
    min-height: 42rem;
    padding: 4.5rem;
  }

  .hero-media::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: "";
    background:
      linear-gradient(90deg, rgb(7 11 9 / 92%), rgb(7 11 9 / 35%)),
      linear-gradient(0deg, #101611, transparent 55%);
  }

  .hero-media > img {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.38) saturate(0.75) brightness(0.74);
  }

  .hero-media__content {
    width: min(100%, var(--page-max));
    margin-inline: auto;
  }

  .hero-media :global(.lead) {
    color: #e6ddc9;
  }

  .hero-media__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.6rem;
  }

  @media (max-width: 800px) {
    .hero-media,
    .hero-media--compact {
      min-height: 48rem;
      padding: 3rem var(--page-gutter);
    }
  }

  @media (max-width: 450px) {
    .hero-media,
    .hero-media--compact {
      min-height: 44rem;
      padding: 2.3rem var(--page-gutter);
    }
  }
</style>
