---
export interface Props {
  /** Con `href` se renderiza un enlace; sin él, un botón nativo. */
  href?: string;
  variant?: "primary" | "ghost" | "subtle" | "danger";
  size?: "small" | "regular";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
  target?: string;
  rel?: string;
  [attribute: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "regular",
  type = "button",
  disabled = false,
  class: className = "",
  target,
  rel,
  ...attributes
} = Astro.props;
const safeRel = target === "_blank" ? rel || "noreferrer" : rel;
const classes = ["button", `button--${variant}`, `button--${size}`, className];
---

{href ? (
  <a
    {...attributes}
    class:list={classes}
    href={disabled ? undefined : href}
    target={target}
    rel={safeRel}
    aria-disabled={disabled ? "true" : undefined}
    tabindex={disabled ? -1 : undefined}
  >
    <slot />
  </a>
) : (
  <button {...attributes} class:list={classes} type={type} disabled={disabled}>
    <slot />
  </button>
)}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 4.8rem;
    padding: 0 2.1rem;
    border: 1px solid var(--color-gold);
    border-radius: 0;
    background: linear-gradient(135deg, #edcf70, #b87d20);
    color: #171208;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), filter var(--transition-fast);
  }

  .button:hover:not(:disabled, [aria-disabled="true"]) {
    transform: translateY(-0.2rem);
    box-shadow: 0 1rem 2.5rem rgb(214 166 66 / 20%);
  }

  .button--ghost,
  .button--subtle {
    background: transparent;
    color: var(--color-paper);
  }

  .button--subtle {
    border-color: var(--color-line);
  }

  .button--danger {
    border-color: var(--color-danger);
    background: transparent;
    color: var(--color-danger);
  }

  .button--small {
    min-height: 4.4rem;
    padding-inline: 1.4rem;
    font-size: 1.1rem;
  }

  .button:disabled,
  .button[aria-disabled="true"] {
    cursor: not-allowed;
    filter: grayscale(0.6);
    opacity: 0.55;
  }
</style>
