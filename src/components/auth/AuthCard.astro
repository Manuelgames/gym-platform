---
import Brand from "../branding/Brand.astro";

export interface Props {
  title: string;
  description: string;
  labelledby?: string;
}

const { title, description, labelledby = "auth-title" } = Astro.props;
---

<section class="auth-card" aria-labelledby={labelledby}>
  <Brand href="/" />
  <h1 id={labelledby}>{title}</h1>
  <p>{description}</p>
  <div class="auth-card__content"><slot /></div>
  {Astro.slots.has("footer") && <footer class="auth-card__footer"><slot name="footer" /></footer>}
</section>

<style>
  .auth-card {
    width: min(100%, 51rem);
    padding: 3.5rem;
    border: 1px solid var(--color-line);
    background: linear-gradient(145deg, rgb(36 46 40 / 98%), rgb(12 18 14 / 98%));
    box-shadow: var(--shadow-raised);
  }

  h1 {
    margin: 3.7rem 0 0.7rem;
    font: 700 3.8rem/1 var(--font-display);
  }

  p {
    color: var(--color-muted);
  }

  .auth-card__footer {
    margin-top: 2rem;
    color: var(--color-muted);
    font-size: 1.4rem;
  }

  .auth-card__footer :global(a) {
    color: var(--color-gold-light);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 800px) {
    .auth-card {
      padding: 2.5rem;
    }
  }

  @media (max-width: 450px) {
    h1 {
      font-size: 3.2rem;
    }
  }
</style>
