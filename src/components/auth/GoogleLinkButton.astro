---
export interface Props {
  clientId: string;
  action: string;
  csrfToken: string;
}

const { clientId, action, csrfToken } = Astro.props;
---

<div class="google-link" id="google-link-button"></div>
<noscript>Activa JavaScript para vincular Google.</noscript>

<script is:inline define:vars={{ clientId, action, csrfToken }}>
  window.__renderRomanGoogleLink = () => {
    if (!window.google?.accounts?.id) return;
    window.google.accounts.id.initialize({
      client_id: clientId,
      use_fedcm_for_button: true,
      callback: ({ credential }) => {
        if (!credential) return;
        const form = document.createElement('form');
        form.method = 'post';
        form.action = action;
        const credentialField = document.createElement('input');
        credentialField.type = 'hidden';
        credentialField.name = 'credential';
        credentialField.value = credential;
        const csrfField = document.createElement('input');
        csrfField.type = 'hidden';
        csrfField.name = 'csrfToken';
        csrfField.value = csrfToken;
        form.append(credentialField, csrfField);
        document.body.append(form);
        form.submit();
      },
    });
    window.google.accounts.id.renderButton(
      document.getElementById('google-link-button'),
      {
        type: 'standard',
        size: 'large',
        theme: 'outline',
        text: 'continue_with',
        shape: 'rectangular',
        logo_alignment: 'left',
        locale: 'es',
      },
    );
  };
</script>
<script
  is:inline
  src="https://accounts.google.com/gsi/client?hl=es"
  async
  onload="window.__renderRomanGoogleLink?.()"
></script>

<style>
  .google-link { display: grid; justify-items: start; min-height: 4.4rem; }
  noscript { color: var(--color-muted); font-size: 1.3rem; }
</style>
