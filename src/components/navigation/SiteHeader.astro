---
import Brand from "../branding/Brand.astro";

export interface HeaderUser {
  id: string;
  name: string;
  email: string;
  profilePhotoId?: string | null;
}

export interface Props {
  /** Usuario resuelto en servidor. `null` produce la navegación pública para invitados. */
  user?: HeaderUser | null;
  /** Ruta de la petición; se usa exclusivamente para `aria-current` y el estilo activo. */
  currentPath: string;
  /** La variante app muestra el área privada y sus herramientas. */
  variant?: "public" | "app";
  /** Demo oculta los controles de autenticación y comparte un único perfil. */
  accessMode?: "authenticated" | "demo";
  /** Genera Mi trabajo solo cuando existe al menos un rol profesional activo. */
  showWork?: boolean;
}

const {
  user = null,
  currentPath,
  variant = "public",
  accessMode = "authenticated",
  showWork = false,
} = Astro.props;
const pathOnly = currentPath.split(/[?#]/, 1)[0] || "/";
const normalizedPath = pathOnly !== "/" ? pathOnly.replace(/\/+$/, "") : "/";
const firstName = user?.name.trim().split(/\s+/)[0] || "guerrero";
const demoMode = accessMode === "demo";

const toolItems = [
  { href: "/app/rutina", label: "Rutina" },
  { href: "/app/dieta", label: "Dieta" },
  { href: "/app/calculadora", label: "Calorías" },
  { href: "/app/especialistas", label: "Especialistas" },
];
const imperialHref =
  variant === "app" || user || demoMode ? "/app" : "/iniciar-sesion";
const isCurrent = (href: string) => normalizedPath === href;
const isToolsCurrent = toolItems.some((item) => isCurrent(item.href));
const isProfileCurrent =
  isCurrent("/app/mi-trabajo") || isCurrent("/app/perfil");
const isImperioCurrent = variant === "app" && isCurrent("/app");
---

<header class="site-header" data-site-header>
  <Brand href={variant === "app" ? "/app" : "/"} />

  <button
    class="nav-toggle"
    type="button"
    aria-controls="site-navigation"
    aria-expanded="false"
    aria-label="Abrir menú"
    data-nav-toggle
  >
    <span aria-hidden="true">☰</span>
  </button>

  <nav
    id="site-navigation"
    class="site-nav"
    aria-label="Navegación principal"
    data-site-nav
  >
    <a
      href={imperialHref}
      class:list={{ "is-current": isImperioCurrent }}
      aria-current={isImperioCurrent ? "page" : undefined}
    >
      Mi Imperio
    </a>
    <a
      href="/blog"
      class:list={{ "is-current": isCurrent("/blog") }}
      aria-current={isCurrent("/blog") ? "page" : undefined}
    >
      Blog
    </a>
    <details
      class:list={[
        "nav-menu",
        "nav-menu--tools",
        { "is-current": isToolsCurrent },
      ]}
      data-nav-menu
    >
      <summary aria-current={isToolsCurrent ? "page" : undefined}>
        Herramientas
        <span class="nav-menu__chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="nav-menu__panel">
        {
          toolItems.map((item) => (
            <a
              href={item.href}
              class:list={{ "is-current": isCurrent(item.href) }}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </details>

    <details
      class:list={[
        "nav-menu",
        "nav-menu--profile",
        { "is-current": isProfileCurrent },
      ]}
      data-nav-menu
    >
      <summary aria-current={isProfileCurrent ? "page" : undefined}>
        {
          user?.profilePhotoId && (
            <img
              class="nav-menu__avatar"
              src={`/api/profile/photo/${user.id}`}
              alt=""
              width="32"
              height="32"
            />
          )
        }
        Perfil
        <span class="nav-menu__chevron" aria-hidden="true">⌄</span>
      </summary>
      <div class="nav-menu__panel">
        {
          user && (
            <span class="nav-menu__user" title={user.email}>
              <strong>Salve, {firstName}</strong>
              <small>{user.email}</small>
            </span>
          )
        }
        {demoMode && <span class="nav-menu__user">Vista demo compartida</span>}

        <a
          href={user || demoMode ? "/app/perfil" : "/iniciar-sesion"}
          class:list={{ "is-current": isCurrent("/app/perfil") }}
          aria-current={isCurrent("/app/perfil") ? "page" : undefined}
        >
          Mi perfil
        </a>

        {
          showWork && (
            <a
              href="/app/mi-trabajo"
              class:list={{ "is-current": isCurrent("/app/mi-trabajo") }}
              aria-current={isCurrent("/app/mi-trabajo") ? "page" : undefined}
            >
              Mi trabajo
            </a>
          )
        }

        {
          demoMode ? null : user ? (
            <form
              class="site-nav__logout"
              method="POST"
              action="/api/auth/logout"
            >
              <button type="submit">Cerrar sesión</button>
            </form>
          ) : (
            <Fragment>
              <a
                href="/iniciar-sesion"
                class:list={{ "is-current": isCurrent("/iniciar-sesion") }}
                aria-current={isCurrent("/iniciar-sesion") ? "page" : undefined}
              >
                Iniciar sesión
              </a>
              <a
                class="nav-menu__cta"
                href="/registro"
                class:list={{ "is-current": isCurrent("/registro") }}
                aria-current={isCurrent("/registro") ? "page" : undefined}
              >
                Crear cuenta
              </a>
            </Fragment>
          )
        }
      </div>
    </details>
  </nav>
</header>

<script>
  import "../../scripts/site-navigation";
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: min(calc(100% - 3rem), var(--page-max));
    min-height: 6rem;
    margin-inline: auto;
    padding: 0.7rem 1.2rem;
    border: 1px solid rgb(231 194 104 / 24%);
    border-radius: 2.4rem;
    background: linear-gradient(
      135deg,
      rgb(20 29 24 / 86%),
      rgb(10 15 12 / 78%)
    );
    box-shadow:
      0 1rem 3rem rgb(0 0 0 / 28%),
      inset 0 1px 0 rgb(255 255 255 / 4%);
    backdrop-filter: blur(1.8rem) saturate(1.2);
  }

  .site-header :global(.brand) {
    position: absolute;
    left: 1.3rem;
    max-width: 30%;
  }

  .nav-toggle {
    display: none;
    position: absolute;
    right: 1.2rem;
    width: 4.4rem;
    min-width: 4.4rem;
    height: 4.4rem;
    place-items: center;
    border: 1px solid var(--color-line-soft);
    border-radius: 1.4rem;
    background: rgb(255 255 255 / 3%);
    color: var(--color-paper);
    font-size: 2.2rem;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .site-nav > a,
  .nav-menu > summary,
  .nav-menu__panel a,
  .nav-menu__panel button,
  .nav-menu__item {
    border: 0;
    color: var(--color-muted);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .site-nav > a,
  .nav-menu > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 4.4rem;
    padding: 0.8rem 1.15rem;
    border-radius: 1.4rem;
    cursor: pointer;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .site-nav > a:hover,
  .site-nav > a.is-current,
  .nav-menu > summary:hover,
  .nav-menu.is-current > summary,
  .nav-menu__panel a:hover,
  .nav-menu__panel a.is-current,
  .nav-menu__panel button:hover {
    color: var(--color-paper);
    background: rgb(214 166 66 / 12%);
  }

  .site-nav > a.is-current,
  .nav-menu.is-current > summary {
    color: var(--color-gold-light);
  }

  .nav-menu {
    position: relative;
  }

  .nav-menu > summary {
    list-style: none;
  }

  .nav-menu > summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu__chevron {
    color: var(--color-gold-light);
    font-size: 1.5rem;
    line-height: 1;
    transform: translateY(-0.1rem);
    transition: transform var(--transition-fast);
  }

  .nav-menu__avatar {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    object-fit: cover;
  }

  .nav-menu[open] .nav-menu__chevron {
    transform: rotate(180deg) translateY(-0.1rem);
  }

  .nav-menu__panel {
    position: absolute;
    top: calc(100% + 0.9rem);
    right: 0;
    display: grid;
    min-width: 22rem;
    gap: 0.3rem;
    padding: 0.8rem;
    border: 1px solid rgb(231 194 104 / 22%);
    border-radius: 1.6rem;
    background: rgb(18 27 22 / 94%);
    box-shadow: 0 1.4rem 3.5rem rgb(0 0 0 / 38%);
    backdrop-filter: blur(1.8rem);
  }

  .nav-menu--tools .nav-menu__panel {
    right: auto;
    left: 50%;
    transform: translateX(-50%);
  }

  .nav-menu__panel a,
  .nav-menu__panel button,
  .nav-menu__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 4.2rem;
    padding: 0.9rem 1.1rem;
    border-radius: 1rem;
    background: transparent;
    text-align: left;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .nav-menu__panel a.is-current {
    color: var(--color-gold-light);
  }

  .nav-menu__user {
    display: grid;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem 1.1rem;
    border-bottom: 1px solid var(--color-line-soft);
    color: var(--color-paper);
  }

  .nav-menu__user small,
  .nav-menu__item small {
    color: var(--color-muted);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .nav-menu__item--disabled {
    cursor: not-allowed;
    opacity: 0.62;
  }

  .nav-menu__cta {
    color: var(--color-gold-light) !important;
  }

  .site-nav__logout {
    margin: 0;
  }

  .site-nav__logout button {
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .site-header {
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .site-header :global(.brand) {
      max-width: calc(100% - 6.4rem);
    }

    .nav-toggle {
      display: grid;
    }

    /* Sin JavaScript la lista permanece visible y navegable debajo de la marca. */
    .site-nav {
      display: grid;
      width: 100%;
      margin-top: 5.3rem;
      padding: 0.8rem;
      gap: 0.3rem;
    }

    .site-header[data-navigation-ready="true"] .site-nav {
      position: absolute;
      top: calc(100% + 0.8rem);
      right: 0;
      left: 0;
      display: none;
      width: auto;
      margin-top: 0;
      padding: 0.8rem;
      border: 1px solid rgb(231 194 104 / 22%);
      border-radius: 1.8rem;
      background: rgb(18 27 22 / 96%);
      box-shadow: 0 1.4rem 3.5rem rgb(0 0 0 / 38%);
      backdrop-filter: blur(1.8rem);
    }

    .site-header[data-navigation-ready="true"] .site-nav.is-open {
      display: grid;
    }

    .site-nav > a,
    .nav-menu > summary {
      width: 100%;
      justify-content: space-between;
      text-align: left;
    }

    .nav-menu__panel,
    .nav-menu--tools .nav-menu__panel {
      position: static;
      min-width: 0;
      margin: 0.2rem 0 0.5rem;
      transform: none;
      border: 0;
      border-radius: 1rem;
      background: rgb(0 0 0 / 16%);
      box-shadow: none;
      backdrop-filter: none;
    }
  }

  @media (max-width: 450px) {
    .site-header {
      width: calc(100% - 2rem);
      top: 0.8rem;
    }

    .site-header :global(.brand) {
      left: 0.9rem;
      max-width: calc(100% - 6.1rem);
      font-size: 1.35rem;
    }
  }
</style>
