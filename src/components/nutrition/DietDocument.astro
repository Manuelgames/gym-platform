---
import type { DietPlan } from '../../domain/diet/diet';
import Button from '../ui/Button.astro';

export interface DietProfileSummary {
  name: string;
  age?: number | null;
  weightKg?: number | null;
  heightCm?: number | null;
}

export interface Props {
  plan: DietPlan;
  pdfHref?: string;
  authorName?: string;
  profile?: DietProfileSummary;
}

const { plan, pdfHref, authorName, profile } = Astro.props;
const sourceLabel = plan.source === 'ai'
  ? plan.generationEngine === 'openai' ? 'Generada con IA' : 'Generación automática local'
  : plan.source === 'manual' ? 'Creada por ti' : 'Asignada por especialista';
const preferenceLabels = {
  general: 'Alimentación general',
  vegetariana: 'Vegetariana',
  vegana: 'Vegana',
  pescetariana: 'Pescetariana',
  sin_lactosa: 'Sin lactosa',
  rapida: 'Preparación rápida',
};
const goalLabels = {
  ganar: 'Fuerza y masa muscular',
  mantener: 'Mantenimiento y energía',
  perder: 'Reducción gradual de grasa',
};
const updated = new Intl.DateTimeFormat('es-MX', { dateStyle: 'long' }).format(new Date(plan.updatedAt));
const iconPrefix = `diet-${plan.id.replace(/[^a-zA-Z0-9_-]/g, '')}`;
const profileName = profile?.name || 'Usuario';
const height = profile?.heightCm ? `${(profile.heightCm / 100).toFixed(2)} m` : 'Sin registro';
const age = profile?.age ? `${profile.age} años` : 'Sin registro';
const weight = profile?.weightKg ? `${profile.weightKg} kg` : 'Sin registro';

function mealIcon(type: string, index: number): string {
  const normalized = type.toLocaleLowerCase('es-MX');
  if (normalized.includes('desayuno')) return 'sun';
  if (normalized.includes('cena') || normalized.includes('dormir')) return 'moon';
  if (normalized === 'comida' || normalized.includes('principal')) return 'plate';
  return index % 2 === 0 ? 'apple' : 'bowl';
}

function displayTime(value: string): string {
  if (!value) return 'Horario libre';
  const [rawHour, minute] = value.split(':').map(Number);
  if (!Number.isInteger(rawHour) || !Number.isInteger(minute)) return value;
  const suffix = rawHour! < 12 ? 'am' : 'pm';
  const hour = rawHour! % 12 || 12;
  return `${hour}:${String(minute).padStart(2, '0')} ${suffix}`;
}
---

<article class="diet-sheet">
  <img
    class="diet-sheet__watermark"
    src="/assets/logosintexto.png"
    alt=""
    width="504"
    height="522"
    loading="lazy"
    decoding="async"
    aria-hidden="true"
  />
  <svg class="diet-sheet__symbols" aria-hidden="true">
    <defs>
      <symbol id={`${iconPrefix}-user`} viewBox="0 0 48 48">
        <circle cx="24" cy="14" r="8"></circle><path d="M9 42c0-9 6-15 15-15s15 6 15 15"></path>
      </symbol>
      <symbol id={`${iconPrefix}-calendar`} viewBox="0 0 48 48">
        <rect x="7" y="10" width="34" height="31" rx="3"></rect><path d="M15 6v8M33 6v8M7 19h34M15 26h4M24 26h4M33 26h2M15 34h4M24 34h4"></path>
      </symbol>
      <symbol id={`${iconPrefix}-scale`} viewBox="0 0 48 48">
        <rect x="7" y="8" width="34" height="34" rx="6"></rect><path d="M16 20a8 8 0 0 1 16 0M24 20l5-5"></path>
      </symbol>
      <symbol id={`${iconPrefix}-ruler`} viewBox="0 0 48 48">
        <path d="M18 5h12v38H18zM18 12h7M18 19h5M18 26h7M18 33h5"></path>
      </symbol>
      <symbol id={`${iconPrefix}-target`} viewBox="0 0 48 48">
        <circle cx="22" cy="26" r="16"></circle><circle cx="22" cy="26" r="9"></circle><circle cx="22" cy="26" r="2"></circle><path d="M25 23 42 6M34 6h8v8"></path>
      </symbol>
      <symbol id={`${iconPrefix}-sun`} viewBox="0 0 48 48">
        <circle cx="24" cy="24" r="9"></circle><path d="M24 4v7M24 37v7M4 24h7M37 24h7M10 10l5 5M33 33l5 5M38 10l-5 5M15 33l-5 5"></path>
      </symbol>
      <symbol id={`${iconPrefix}-apple`} viewBox="0 0 48 48">
        <path d="M25 15c2-6 7-8 11-7-1 5-5 8-11 7Z"></path><path d="M24 17c-12-8-19 3-15 14 4 12 11 14 15 9 4 5 11 3 15-9 4-11-3-22-15-14Z"></path><path d="M24 17c0-4-2-7-5-9"></path>
      </symbol>
      <symbol id={`${iconPrefix}-plate`} viewBox="0 0 48 48">
        <circle cx="25" cy="25" r="14"></circle><circle cx="25" cy="25" r="8"></circle><path d="M7 8v13M4 8v8c0 3 6 3 6 0V8M7 21v19M42 8v32M38 8v12c0 3 4 3 4 0"></path>
      </symbol>
      <symbol id={`${iconPrefix}-bowl`} viewBox="0 0 48 48">
        <path d="M7 21h34c0 12-7 19-17 19S7 33 7 21Z"></path><path d="M13 17c1-5 6-7 10-3 3-6 10-5 12 3M17 40h14"></path>
      </symbol>
      <symbol id={`${iconPrefix}-moon`} viewBox="0 0 48 48">
        <path d="M35 35A18 18 0 0 1 20 5a18 18 0 1 0 15 30Z"></path><path d="m34 9 1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3ZM40 21l1 2 2 1-2 1-1 2-1-2-2-1 2-1 1-2Z"></path>
      </symbol>
      <symbol id={`${iconPrefix}-drop`} viewBox="0 0 48 48">
        <path d="M24 4S10 21 10 31a14 14 0 0 0 28 0C38 21 24 4 24 4Z"></path><path d="M18 33c1 4 4 6 8 6"></path>
      </symbol>
      <symbol id={`${iconPrefix}-leaf`} viewBox="0 0 48 48">
        <path d="M41 7C23 8 12 18 11 34c15 2 27-8 30-27Z"></path><path d="M7 41c8-12 17-20 29-28"></path>
      </symbol>
    </defs>
  </svg>

  <header class="diet-sheet__masthead">
    <div class="diet-sheet__heading">
      <div class="diet-sheet__kicker">
        <span>{sourceLabel}</span>
        <span>{preferenceLabels[plan.preference]}</span>
      </div>
      <h2>{plan.title}</h2>
      <p>Plan alimenticio personalizado · {plan.requestedMeals} {plan.requestedMeals === 1 ? 'comida' : 'comidas'} al día</p>
      <small>
        Actualizado el {updated}{authorName ? ` · Elaborado por ${authorName}` : ''}
      </small>
    </div>
    <div class="diet-sheet__brand-mark" aria-hidden="true">
      <svg viewBox="0 0 48 48"><use href={`#${iconPrefix}-leaf`}></use></svg>
    </div>
    {pdfHref && <Button class="diet-sheet__download" href={pdfHref} variant="ghost" size="small">Descargar PDF</Button>}
  </header>

  {plan.summary && <p class="diet-sheet__summary">{plan.summary}</p>}

  <dl class="profile-strip" aria-label="Datos personales del plan">
    <div>
      <svg aria-hidden="true"><use href={`#${iconPrefix}-user`}></use></svg>
      <dt>Nombre</dt><dd>{profileName}</dd>
    </div>
    <div>
      <svg aria-hidden="true"><use href={`#${iconPrefix}-calendar`}></use></svg>
      <dt>Edad</dt><dd>{age}</dd>
    </div>
    <div>
      <svg aria-hidden="true"><use href={`#${iconPrefix}-scale`}></use></svg>
      <dt>Peso</dt><dd>{weight}</dd>
    </div>
    <div>
      <svg aria-hidden="true"><use href={`#${iconPrefix}-ruler`}></use></svg>
      <dt>Estatura</dt><dd>{height}</dd>
    </div>
    <div class="profile-strip__objective">
      <svg aria-hidden="true"><use href={`#${iconPrefix}-target`}></use></svg>
      <dt>Objetivo</dt><dd>{goalLabels[plan.goal]}</dd>
    </div>
  </dl>

  {plan.nutrition && (
    <dl class="nutrition-ribbon" aria-label="Objetivos nutricionales diarios aproximados">
      <div><dt>Energía</dt><dd>{plan.nutrition.caloriesKcal.toLocaleString('es-MX')} <span>kcal</span></dd></div>
      <div><dt>Proteína</dt><dd>{plan.nutrition.proteinG} <span>g</span></dd></div>
      <div><dt>Carbohidratos</dt><dd>{plan.nutrition.carbsG} <span>g</span></dd></div>
      <div><dt>Grasas</dt><dd>{plan.nutrition.fatG} <span>g</span></dd></div>
    </dl>
  )}

  <section class="daily-distribution" aria-labelledby={`${iconPrefix}-distribution`}>
    <div class="sheet-section-title">
      <span></span><h3 id={`${iconPrefix}-distribution`}>Distribución del día</h3><span></span>
    </div>
    <ol class="meal-timeline">
      {plan.entries.map((meal, index) => (
        <li>
          <svg aria-hidden="true"><use href={`#${iconPrefix}-${mealIcon(meal.type, index)}`}></use></svg>
          <strong>{meal.type}</strong>
          <time datetime={meal.time || undefined}>{displayTime(meal.time)}</time>
        </li>
      ))}
    </ol>
  </section>

  <section class="meal-plan" aria-label="Detalle de comidas">
    {plan.entries.map((meal, index) => (
      <article class="meal-row">
        <div class="meal-row__visual" aria-hidden="true">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <svg><use href={`#${iconPrefix}-${mealIcon(meal.type, index)}`}></use></svg>
        </div>
        <header>
          <p>{displayTime(meal.time)}</p>
          <h3>{meal.type}</h3>
          <small>{meal.title}</small>
          {meal.estimatedCaloriesKcal && <strong>{meal.estimatedCaloriesKcal} kcal aprox.</strong>}
        </header>
        <div class="meal-row__content">
          <ul>
            {meal.ingredients.map((ingredient) => (
              <li>
                <strong>{ingredient.amount} {ingredient.unit}</strong> de {ingredient.name}
                {ingredient.note && <small>{ingredient.note}</small>}
              </li>
            ))}
          </ul>
          {(meal.preparation || meal.notes) && (
            <div class="meal-row__notes">
              {meal.preparation && <p><strong>Preparación:</strong> {meal.preparation}</p>}
              {meal.notes && <p><strong>Nota:</strong> {meal.notes}</p>}
            </div>
          )}
        </div>
      </article>
    ))}
  </section>

  <section class="diet-sheet__guidance" aria-label="Hidratación y recomendaciones">
    <article class="hydration-card">
      <svg aria-hidden="true"><use href={`#${iconPrefix}-drop`}></use></svg>
      <div>
        <h3>Hidratación</h3>
        <p>Distribuye agua durante el día.</p>
        <strong>2–2.5 litros</strong>
        <small>si no existe una indicación clínica distinta</small>
      </div>
    </article>
    <article class="recommendation-card">
      <h3>Recomendaciones generales</h3>
      <ul>
        <li>Prioriza alimentos frescos y variados.</li>
        <li>Evita bebidas con azúcares añadidos.</li>
        <li>Respeta horarios que puedas sostener.</li>
        <li>Ajusta porciones con seguimiento profesional.</li>
        <li>Combina el plan con descanso y actividad física.</li>
      </ul>
    </article>
  </section>

  <footer class="diet-sheet__footer">
    <svg aria-hidden="true"><use href={`#${iconPrefix}-leaf`}></use></svg>
    <p>Las cantidades son aproximadas y no sustituyen una valoración médica o nutricional individual.</p>
  </footer>
</article>

<style>
  .diet-sheet {
    --sheet-green: #0e4829;
    --sheet-green-mid: #477b2b;
    --sheet-green-soft: #eaf2df;
    --sheet-cream: #fbfaf4;
    --sheet-line: #b6c98d;
    --sheet-gold: #c6a26a;
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.8rem, 4vw, 3.4rem);
    overflow: hidden;
    border: 1px solid #d9ddcf;
    border-radius: 1.2rem;
    background:
      radial-gradient(circle at 92% 3%, rgb(121 157 65 / 11%), transparent 18rem),
      linear-gradient(145deg, #fff, var(--sheet-cream));
    box-shadow: 0 2.2rem 6rem rgb(0 0 0 / 22%);
    color: #152219;
  }
  .diet-sheet > :not(.diet-sheet__watermark) { position: relative; z-index: 1; }
  .diet-sheet__watermark { position: absolute; z-index: 0; top: 50%; left: 50%; width: 20px; height: 20px; border-radius: 15px; opacity: .05; object-fit: cover; pointer-events: none; transform: translate(-50%, -50%); user-select: none; }
  .diet-sheet__symbols { position: absolute; width: 0; height: 0; overflow: hidden; }
  .diet-sheet svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .diet-sheet__masthead { position: relative; display: grid; grid-template-columns: 1fr auto; align-items: start; gap: 1.5rem; padding-right: 8rem; }
  .diet-sheet__heading { min-width: 0; }
  .diet-sheet__kicker { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: .8rem; }
  .diet-sheet__kicker span { padding: .4rem .75rem; border: 1px solid var(--sheet-line); border-radius: 99rem; color: var(--sheet-green-mid); font-size: .95rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .diet-sheet h2 { max-width: 82rem; margin: 0; color: var(--sheet-green); font: 800 clamp(2.7rem, 5vw, 4.5rem)/1.04 var(--font-display); letter-spacing: -.025em; }
  .diet-sheet__heading > p { margin: .7rem 0 .2rem; color: #4f5c53; font-size: 1.5rem; font-style: italic; }
  .diet-sheet__heading > small { color: #69736c; }
  .diet-sheet__brand-mark { position: absolute; top: 0; right: 0; display: grid; width: 6.5rem; height: 6.5rem; place-items: center; color: #7da447; }
  .diet-sheet__brand-mark svg { width: 100%; height: 100%; stroke-width: 1.5; }
  :global(.diet-sheet__download.button) { grid-column: 2; margin-top: 6.8rem; border-color: var(--sheet-green-mid); background: #fff; color: var(--sheet-green); }
  .diet-sheet__summary { margin: 0; padding: 1.2rem 1.4rem; border-left: .35rem solid var(--sheet-green-mid); background: #f2f5eb; color: #4b574f; font-size: 1.35rem; }
  .profile-strip { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(18rem, 1.25fr); margin: 0; overflow: hidden; border: 1px solid #86aa58; border-radius: 1.2rem; background: rgb(255 255 255 / 72%); }
  .profile-strip > div { display: grid; min-width: 0; padding: 1.4rem 1rem; place-items: center; border-right: 1px solid #e1d4bd; text-align: center; }
  .profile-strip > div:last-child { border-right: 0; }
  .profile-strip svg { width: 3.4rem; height: 3.4rem; margin-bottom: .55rem; color: var(--sheet-green); }
  .profile-strip dt { color: var(--sheet-green); font-size: 1.15rem; font-weight: 900; }
  .profile-strip dd { max-width: 100%; margin: .2rem 0 0; color: #202a23; font-size: 1.3rem; line-height: 1.25; overflow-wrap: anywhere; }
  .profile-strip__objective dd { font-weight: 700; }
  .nutrition-ribbon { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; overflow: hidden; border: 1px solid #dce5ca; border-radius: .8rem; background: #f5f8ef; }
  .nutrition-ribbon > div { padding: 1rem 1.3rem; border-right: 1px solid #dce5ca; text-align: center; }
  .nutrition-ribbon > div:last-child { border-right: 0; }
  .nutrition-ribbon dt { color: #66725e; font-size: .95rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .nutrition-ribbon dd { margin: .15rem 0 0; color: var(--sheet-green); font: 800 1.75rem var(--font-display); }
  .nutrition-ribbon dd span { color: #66725e; font: 600 1rem var(--font-body); }
  .daily-distribution { display: grid; gap: 1rem; }
  .sheet-section-title { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.6rem; color: var(--sheet-green); }
  .sheet-section-title span { height: .2rem; background: linear-gradient(90deg, var(--sheet-green-mid), #8eb061); }
  .sheet-section-title span:last-child { background: linear-gradient(90deg, #8eb061, var(--sheet-green-mid)); }
  .sheet-section-title h3 { margin: 0; font: 800 clamp(2rem, 4vw, 2.8rem) var(--font-display); }
  .meal-timeline { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); margin: 0; padding: 0; overflow: hidden; border-radius: 1rem; background: #f1f4e9; list-style: none; }
  .meal-timeline::before { position: absolute; top: 4.5rem; right: 2rem; left: 2rem; height: .2rem; content: ''; background: repeating-linear-gradient(90deg, #6f984a 0 4px, transparent 4px 7px); }
  .meal-timeline li { position: relative; z-index: 1; display: grid; min-width: 0; padding: 1rem .7rem 1.2rem; place-items: center; text-align: center; }
  .meal-timeline li::after { position: absolute; top: 4.15rem; width: .85rem; height: .85rem; border: 2px solid #f1f4e9; border-radius: 50%; background: var(--sheet-green-mid); content: ''; }
  .meal-timeline svg { position: relative; z-index: 1; width: 3.7rem; height: 3.7rem; margin-bottom: 1.4rem; padding: .2rem; background: #f1f4e9; color: var(--sheet-green-mid); }
  .meal-timeline strong { max-width: 100%; color: var(--sheet-green); font-size: 1.15rem; line-height: 1.15; }
  .meal-timeline time { margin-top: .2rem; color: #465148; font-size: 1.05rem; }
  .meal-plan { display: grid; gap: .7rem; }
  .meal-row { display: grid; grid-template-columns: 9rem minmax(14rem, .65fr) minmax(0, 1.6fr); overflow: hidden; border: 1px solid #d9bd90; border-radius: 1rem; background: rgb(255 255 255 / 70%); }
  .meal-row__visual { position: relative; display: grid; min-height: 12rem; place-items: center; border-right: 1px solid #ead9bd; background: radial-gradient(circle, #dce9ca, #f7f4e9 68%); color: var(--sheet-green-mid); }
  .meal-row__visual span { position: absolute; top: .8rem; left: .8rem; color: #8c9d81; font: 700 1rem var(--font-display); }
  .meal-row__visual svg { width: 5.8rem; height: 5.8rem; stroke-width: 1.5; }
  .meal-row > header { display: grid; align-content: center; padding: 1.2rem 1.5rem; border-right: 1px solid #ead9bd; }
  .meal-row > header p { margin: 0 0 .35rem; color: #74806f; font-size: .95rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .meal-row > header h3 { margin: 0; color: var(--sheet-green); font: 800 clamp(1.7rem, 3vw, 2.4rem)/1.05 var(--font-display); }
  .meal-row > header small { margin-top: .35rem; color: #4d594f; line-height: 1.25; }
  .meal-row > header strong { margin-top: .55rem; color: var(--sheet-green-mid); font-size: 1rem; }
  .meal-row__content { display: grid; align-content: center; padding: 1.2rem 1.7rem; }
  .meal-row__content ul { display: grid; gap: .35rem; margin: 0; padding-left: 1.8rem; }
  .meal-row__content li { color: #202a23; font-size: 1.25rem; }
  .meal-row__content li::marker { color: var(--sheet-green); }
  .meal-row__content li > strong { color: var(--sheet-green); }
  .meal-row__content li > small { display: block; color: #718074; font-size: 1rem; }
  .meal-row__notes { margin-top: .8rem; padding-top: .7rem; border-top: 1px solid #e8e9e2; }
  .meal-row__notes p { margin: .25rem 0; color: #59655c; font-size: 1.05rem; }
  .meal-row__notes strong { color: var(--sheet-green); }
  .diet-sheet__guidance { display: grid; grid-template-columns: .9fr 1.1fr; gap: 1.4rem; }
  .hydration-card, .recommendation-card { min-width: 0; padding: 1.6rem; border-radius: 1rem; background: rgb(255 255 255 / 72%); }
  .hydration-card { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.4rem; border: 1px solid #70acd0; }
  .hydration-card > svg { width: 6.5rem; height: 6.5rem; color: #1478ad; }
  .hydration-card h3, .recommendation-card h3 { margin: 0 0 .8rem; padding-bottom: .5rem; border-bottom: 2px solid currentColor; font: 800 2rem var(--font-display); }
  .hydration-card h3 { color: #155f8a; }
  .hydration-card p { margin: 0; color: #46545b; }
  .hydration-card strong { display: block; color: #155f8a; font: 800 2.5rem var(--font-display); }
  .hydration-card small { color: #66737a; }
  .recommendation-card { border: 1px solid #8caf5b; }
  .recommendation-card h3 { color: var(--sheet-green); }
  .recommendation-card ul { display: grid; gap: .45rem; margin: 0; padding-left: 1.8rem; color: #263229; font-size: 1.15rem; }
  .recommendation-card li::marker { color: var(--sheet-green-mid); }
  .diet-sheet__footer { display: flex; align-items: center; justify-content: center; gap: 1rem; padding-top: 1rem; border-top: 2px solid #749c4b; text-align: center; }
  .diet-sheet__footer svg { width: 2.8rem; height: 2.8rem; flex: 0 0 auto; color: #80a84b; }
  .diet-sheet__footer p { margin: 0; color: #657067; font-size: 1.05rem; font-style: italic; }
  @media (max-width: 900px) {
    .profile-strip { grid-template-columns: repeat(3, 1fr); }
    .profile-strip > div { border-bottom: 1px solid #e1d4bd; }
    .profile-strip__objective { grid-column: span 2; }
    .meal-row { grid-template-columns: 7rem minmax(13rem, .7fr) 1.5fr; }
  }
  @media (max-width: 700px) {
    .diet-sheet__masthead { grid-template-columns: 1fr; padding-right: 6rem; }
    :global(.diet-sheet__download.button) { grid-column: 1; width: fit-content; margin-top: 0; }
    .profile-strip { grid-template-columns: repeat(2, 1fr); }
    .profile-strip__objective { grid-column: 1 / -1; }
    .nutrition-ribbon { grid-template-columns: repeat(2, 1fr); }
    .nutrition-ribbon > div { border-bottom: 1px solid #dce5ca; }
    .meal-row { grid-template-columns: 7rem 1fr; }
    .meal-row > header { border-right: 0; }
    .meal-row__content { grid-column: 1 / -1; border-top: 1px solid #ead9bd; }
    .diet-sheet__guidance { grid-template-columns: 1fr; }
  }
  @media (max-width: 450px) {
    .diet-sheet { margin-inline: -.8rem; padding: 1.3rem; border-radius: .6rem; }
    .profile-strip { grid-template-columns: 1fr; }
    .profile-strip__objective { grid-column: auto; }
    .nutrition-ribbon { grid-template-columns: 1fr 1fr; }
    .meal-timeline { grid-template-columns: repeat(2, 1fr); }
    .meal-timeline::before, .meal-timeline li::after { display: none; }
    .meal-timeline svg { margin-bottom: .4rem; }
    .meal-row { grid-template-columns: 5.5rem 1fr; }
    .meal-row__visual svg { width: 4rem; height: 4rem; }
    .hydration-card { grid-template-columns: 1fr; text-align: center; }
    .hydration-card > svg { margin-inline: auto; }
  }
</style>
