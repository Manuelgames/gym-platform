---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/navigation/SiteHeader.astro";

export interface Props {
  title: string;
  description?: string;
  canonical?: string | URL;
}

const { title, description, canonical } = Astro.props;
---

<BaseLayout {title} {description} {canonical} noindex bodyClass="auth-page">
  <Fragment slot="head"><slot name="head" /></Fragment>
  <SiteHeader
    user={Astro.locals.user}
    currentPath={Astro.url.pathname}
    variant="public"
    accessMode={Astro.locals.accessMode}
    showWork={Astro.locals.specialistRoles.length > 0}
  />
  <main id="contenido-principal" class="auth-shell" tabindex="-1">
    <slot />
  </main>
</BaseLayout>

<style is:global>
  /* El encabezado y el formulario comparten el alto visible; así la tarjeta no
     añade un segundo bloque de altura al documento. */
  .auth-page {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    /* `svh` reserva el alto más pequeño de Safari móvil, incluso con sus
       barras visibles, para que la pantalla no cambie de tamaño al navegar. */
    min-block-size: 100vh;
    min-block-size: 100svh;
    block-size: 100vh;
    block-size: 100svh;
  }

  .auth-page .auth-shell {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: clamp(1.6rem, 4vw, 2.4rem);
  }

  /* Mantiene visibles todos los controles en ventanas móviles compactas y
     evita un desbordamiento vertical mínimo en la confirmación de correo. */
  @media (max-height: 700px) {
    .auth-page .auth-shell {
      padding-block: 1.6rem;
    }

    .auth-page .auth-card {
      padding-block: 2.4rem;
    }

    .auth-page .auth-card h1 {
      margin-top: 2.4rem;
    }

    .auth-page .auth-card--without-brand h1 {
      margin-top: 0;
    }
  }
</style>
