---
import AuthCard from '../components/auth/AuthCard.astro';
import AuthProviderSection from '../components/auth/AuthProviderSection.astro';
import GoogleSignInButton from '../components/auth/GoogleSignInButton.astro';
import FormField from '../components/forms/FormField.astro';
import FormMessage from '../components/forms/FormMessage.astro';
import FormStack from '../components/forms/FormStack.astro';
import Button from '../components/ui/Button.astro';
import AuthLayout from '../layouts/AuthLayout.astro';
import { randomBytes } from 'node:crypto';
import { loadAstroServerEnvironment } from '../infrastructure/config/astro-environment';
import { readErrorMessage, readInvalidField } from '../presentation/feedback';

const errorMessage = readErrorMessage(Astro.url);
const invalidField = readInvalidField(Astro.url);
const emailNotVerified = Astro.url.searchParams.get('error') === 'email-not-verified';
const environment = loadAstroServerEnvironment();
const googleEnabled = environment.authProvider === 'google' && Boolean(environment.googleClientId);
const googleAuthCsrf = googleEnabled ? randomBytes(32).toString('base64url') : null;
if (googleAuthCsrf) Astro.session?.set('googleAuthCsrf', googleAuthCsrf, { ttl: 10 * 60 });
---

<AuthLayout title="Iniciar sesión" description="Accede a tu rutina, dieta e historial personal.">
  <AuthCard title="Regresa a la arena" description="Tu rutina, dieta y progreso te esperan en tu cuenta.">
    <FormStack action="/api/auth/login" autocomplete="on">
      <FormField label="Correo electrónico" for="login-email" required error={invalidField === 'email' ? errorMessage : undefined}>
        <input id="login-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-invalid={invalidField === 'email' ? 'true' : undefined} />
      </FormField>
      <FormField label="Contraseña" for="login-password" required error={invalidField === 'password' ? errorMessage : undefined}>
        <input id="login-password" name="password" type="password" autocomplete="current-password" required minlength="8" maxlength="128" aria-invalid={invalidField === 'password' ? 'true' : undefined} />
      </FormField>
      <p class="password-help"><a href="/recuperar-contrasena">¿Olvidaste tu contraseña?</a></p>
      {Astro.url.searchParams.has('reset') && <FormMessage tone="success" message="Contraseña actualizada. Ya puedes iniciar sesión." />}
      {Astro.url.searchParams.has('verified') && <FormMessage tone="success" message="Correo confirmado. Ya puedes iniciar sesión." />}
      <FormMessage message={invalidField ? undefined : errorMessage} tone="error" />
      {emailNotVerified && <p class="verification-help"><a href="/confirmar-correo">Reenviar el enlace de confirmación</a></p>}
      <Button type="submit">Entrar al imperio</Button>
    </FormStack>

    {googleEnabled && environment.googleClientId && (
      <AuthProviderSection>
        {googleAuthCsrf && (
          <GoogleSignInButton
            clientId={environment.googleClientId}
            action="/api/auth/google"
            csrfToken={googleAuthCsrf}
          />
        )}
      </AuthProviderSection>
    )}

    <Fragment slot="footer">¿Aún no tienes cuenta? <a href="/registro">Crea tu perfil de guerrero</a>.</Fragment>
  </AuthCard>
</AuthLayout>

<style>
  .password-help { margin: -.5rem 0 0; text-align: right; font-size: 1.3rem; }
  .password-help a { color: var(--color-gold-light); text-decoration: underline; text-underline-offset: .25em; }
  .verification-help { margin: -.5rem 0 0; font-size: 1.3rem; }
  .verification-help a { color: var(--color-gold-light); text-decoration: underline; text-underline-offset: .25em; }
</style>
