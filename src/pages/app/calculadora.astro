---
import FieldRow from '../../components/forms/FieldRow.astro';
import FormField from '../../components/forms/FormField.astro';
import FormMessage from '../../components/forms/FormMessage.astro';
import FormStack from '../../components/forms/FormStack.astro';
import CalorieResult from '../../components/calculator/CalorieResult.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import Panel from '../../components/ui/Panel.astro';
import TipList from '../../components/ui/TipList.astro';
import { getApplication } from '../../infrastructure/composition/container';
import ProtectedLayout from '../../layouts/ProtectedLayout.astro';
import { readErrorMessage, readInvalidField } from '../../presentation/feedback';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/iniciar-sesion');
const history = await getApplication().getCalories(user.id);
const latest = history[0];
const errorMessage = readErrorMessage(Astro.url);
const invalidField = readInvalidField(Astro.url);
const successMessage = Astro.url.searchParams.has('calculated') ? 'Estimación calculada y añadida a tu historial.' : undefined;
const dateFormatter = new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium', timeStyle: 'short' });

/** Calcula la edad civil para sugerirla sin confundir identidad de perfil y sexo de fórmula. */
function ageFromBirthDate(value: string): number | undefined {
  const birth = new Date(`${value}T00:00:00Z`);
  if (Number.isNaN(birth.valueOf())) return undefined;
  const now = new Date();
  let age = now.getUTCFullYear() - birth.getUTCFullYear();
  const beforeBirthday = now.getUTCMonth() < birth.getUTCMonth()
    || (now.getUTCMonth() === birth.getUTCMonth() && now.getUTCDate() < birth.getUTCDate());
  if (beforeBirthday) age -= 1;
  return age >= 14 && age <= 100 ? age : undefined;
}

const suggestedAge = latest?.age ?? ageFromBirthDate(user.birthDate);
const suggestedFormulaSex = latest?.sex ?? (user.sex === 'mujer' ? 'female' : user.sex === 'hombre' ? 'male' : undefined);
---

<ProtectedLayout title="Calculadora de calorías" {user} currentPath={Astro.url.pathname} footerText="La salud es parte de la travesía: consulta a un profesional ante cualquier condición o duda.">
  <PageIntro
    eyebrow="Conoce tu energía"
    title="La brújula calórica"
    lead="Una estimación de gasto diario basada en Mifflin-St Jeor. Úsala como guía inicial, no como indicación médica."
    compact
  />
  <FormMessage message={successMessage} tone="success" />
  <FormMessage message={errorMessage} tone="error" />

  <section class="content-grid content-grid--planner section-flow" aria-label="Calculadora de calorías">
    <Panel labelledby="calorie-form-title">
      <h2 id="calorie-form-title">Calcula tu base</h2>
      <FormStack action="/api/calories/calculate">
        <FieldRow>
          <FormField label="Edad" for="calorie-age" required error={invalidField === 'age' ? errorMessage : undefined}>
            <input id="calorie-age" name="age" type="number" min="14" max="100" required value={suggestedAge} />
          </FormField>
          <FormField label="Sexo usado por la fórmula" for="calorie-sex" hint="Es un parámetro fisiológico de esta fórmula y es independiente de tu identidad de perfil." required error={invalidField === 'sex' ? errorMessage : undefined}>
            <select id="calorie-sex" name="sex" required>
              <option value="" selected={!suggestedFormulaSex} disabled>Selecciona</option>
              <option value="male" selected={suggestedFormulaSex === 'male'}>Hombre</option>
              <option value="female" selected={suggestedFormulaSex === 'female'}>Mujer</option>
            </select>
          </FormField>
        </FieldRow>
        <FieldRow>
          <FormField label="Peso (kg)" for="calorie-weight" required error={invalidField === 'weight' ? errorMessage : undefined}>
            <input id="calorie-weight" name="weightKg" type="number" min="30" max="300" step="0.1" required value={latest?.weightKg} />
          </FormField>
          <FormField label="Altura (cm)" for="calorie-height" required error={invalidField === 'height' ? errorMessage : undefined}>
            <input id="calorie-height" name="heightCm" type="number" min="120" max="230" required value={latest?.heightCm} />
          </FormField>
        </FieldRow>
        <FormField label="Actividad" for="calorie-activity" required error={invalidField === 'activity' ? errorMessage : undefined}>
          <select id="calorie-activity" name="activityFactor" required>
            <option value="1.2" selected={latest?.activityFactor === 1.2}>Sedentaria</option>
            <option value="1.375" selected={latest?.activityFactor === 1.375}>Ligera · 1–3 días</option>
            <option value="1.55" selected={!latest || latest.activityFactor === 1.55}>Moderada · 3–5 días</option>
            <option value="1.725" selected={latest?.activityFactor === 1.725}>Alta · 6–7 días</option>
            <option value="1.9" selected={latest?.activityFactor === 1.9}>Muy alta</option>
          </select>
        </FormField>
        <Button type="submit">Revelar mi estimación</Button>
      </FormStack>
    </Panel>

    <Panel as="aside" labelledby="calorie-result-title">
      <p class="eyebrow">{latest ? 'Último resultado' : 'Resultado'}</p>
      <h2 id="calorie-result-title">Tu energía diaria</h2>
      <CalorieResult calories={latest?.maintenanceCalories ?? null} bmr={latest?.bmr ?? null} />
      <TipList items={[
        'Para ganar peso, considera un ajuste gradual de +200 a +300 kcal.',
        'Para perder grasa, considera un ajuste gradual de −200 a −400 kcal.',
        'Observa tu progreso durante 2–3 semanas antes de ajustar.',
      ]} />
    </Panel>
  </section>

  <section class="section-flow" aria-labelledby="history-title">
    <header class="history-heading">
      <div><p class="eyebrow">Bitácora personal</p><h2 class="section-title" id="history-title">Tus últimas estimaciones</h2></div>
      <span>{history.length} de 10 registros</span>
    </header>
    {history.length ? (
      <div class="history-list">
        {history.map((item) => (
          <article class="history-item">
            <div><strong>{item.maintenanceCalories.toLocaleString('es-MX')} kcal</strong><span>Mantenimiento estimado</span></div>
            <dl>
              <div><dt>BMR</dt><dd>{item.bmr.toLocaleString('es-MX')} kcal</dd></div>
              <div><dt>Datos</dt><dd>{item.weightKg} kg · {item.heightCm} cm · {item.age} años</dd></div>
              <div><dt>Fecha</dt><dd><time datetime={item.createdAt}>{dateFormatter.format(new Date(item.createdAt))}</time></dd></div>
            </dl>
          </article>
        ))}
      </div>
    ) : <EmptyState message="Aún no hay cálculos. Completa el formulario para iniciar tu bitácora." />}
  </section>
</ProtectedLayout>

<style>
  :global(.form-message) { margin-top: 1.4rem; }
  .history-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.3rem; }
  .history-heading > span { color: var(--color-muted); }
  .history-list { display: grid; gap: 1rem; }
  .history-item { display: grid; grid-template-columns: minmax(18rem, .35fr) 1fr; gap: 2rem; padding: 2rem; border: 1px solid var(--color-line); background: var(--color-surface); }
  .history-item strong { display: block; color: var(--color-gold-light); font: 700 2.5rem var(--font-display); }
  .history-item span { color: var(--color-muted); font-size: 1.25rem; }
  .history-item dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 0; }
  .history-item dl div { min-width: 0; }
  .history-item dt { color: var(--color-muted); font-size: 1.1rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .history-item dd { margin: .4rem 0 0; }
  @media (max-width: 700px) { .history-item { grid-template-columns: 1fr; } .history-item dl { grid-template-columns: 1fr; } }
  @media (max-width: 450px) { .history-heading { align-items: start; flex-direction: column; } }
</style>
