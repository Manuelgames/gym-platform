---
import DashboardHero from '../../components/dashboard/DashboardHero.astro';
import Button from '../../components/ui/Button.astro';
import { getApplication } from '../../infrastructure/composition/container';
import ProtectedLayout from '../../layouts/ProtectedLayout.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/iniciar-sesion');
const dashboard = await getApplication().getDashboard(user.id);
---

<ProtectedLayout title="Mi imperio" {user} currentPath={Astro.url.pathname}>
  <DashboardHero
    name={user.name}
    lead="Organiza tu rutina, planifica tu dieta, calcula tus calorías y encuentra especialistas para avanzar con un plan claro."
    stats={[
      { value: dashboard.hasRoutine ? 'Completado' : 'Pendiente', label: 'Rutina' },
      { value: dashboard.hasDiet ? 'Completado' : 'Pendiente', label: 'Dieta' },
      { value: dashboard.calorieCalculationCount > 0 ? 'Completado' : 'Pendiente', label: 'Calorías' },
    ]}
  >
    <Fragment slot="actions">
      <Button class="dashboard-action" href="/app/rutina">
        <svg class="dashboard-action__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 9v6M8 7v10M16 7v10M19 9v6M8 12h8M3 10h2M19 10h2M3 14h2M19 14h2" />
        </svg>
        <span>Abrir mi rutina</span>
      </Button>
      <Button class="dashboard-action" href="/app/dieta" variant="ghost">
        <svg class="dashboard-action__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15.1 5.1c1.7-1.7 4.4-1.7 5.6-.5s1.2 3.9-.5 5.6l-1.3 1.3c-.5.5-.8 1.2-.8 1.9v.8c0 1.2-.9 2.1-2.1 2.1h-.8c-.7 0-1.4.3-1.9.8l-1.2 1.2c-1.7 1.7-4.4 1.7-5.6.5s-1.2-3.9.5-5.6l1.2-1.2c.5-.5.8-1.2.8-1.9v-.8c0-1.2.9-2.1 2.1-2.1h.8c.7 0 1.4-.3 1.9-.8l1.3-1.3Z" />
          <path d="m5.7 17.8-2 2M3.7 17.8l2 2" />
        </svg>
        <span>Crear dieta</span>
      </Button>
      <Button class="dashboard-action" href="/app/calculadora" variant="ghost">
        <svg class="dashboard-action__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 3h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" />
          <path d="M8 8a4 4 0 0 1 8 0M12 8l2-2M8 17h8" />
        </svg>
        <span>Calorías</span>
      </Button>
      <Button class="dashboard-action" href="/app/especialistas" variant="ghost">
        <svg class="dashboard-action__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 11a3.2 3.2 0 1 0 0-6.4A3.2 3.2 0 0 0 9 11ZM15.8 12.2a2.7 2.7 0 1 0 0-5.4M3.5 19.2c.5-3 2.2-4.8 5.5-4.8s5 1.8 5.5 4.8M15 14.8c2.8.1 4.4 1.5 5 4.4" />
        </svg>
        <span>Especialistas</span>
      </Button>
    </Fragment>
  </DashboardHero>
</ProtectedLayout>
