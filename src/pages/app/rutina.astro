---
import AutomaticRoutineForm from '../../components/routine/AutomaticRoutineForm.astro';
import RoutineDocument from '../../components/routine/RoutineDocument.astro';
import RoutineHistory from '../../components/routine/RoutineHistory.astro';
import RoutinePlanEditor from '../../components/routine/RoutinePlanEditor.astro';
import AppDialog from '../../components/ui/AppDialog.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import FormMessage from '../../components/forms/FormMessage.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import { getApplication } from '../../infrastructure/composition/container';
import ProtectedLayout from '../../layouts/ProtectedLayout.astro';
import { readErrorMessage, readInvalidField } from '../../presentation/feedback';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/iniciar-sesion');
const application = getApplication();
const [automaticRoutine, manualRoutine, specialistRoutine, specialists, automaticHistory, manualHistory] = await Promise.all([
  application.getRoutinePlan(user.id, 'ai'),
  application.getRoutinePlan(user.id, 'manual'),
  application.getRoutinePlan(user.id, 'specialist'),
  application.getSpecialistsPage(user.id),
  application.getRoutineHistory(user.id, 'ai'),
  application.getRoutineHistory(user.id, 'manual'),
]);
const trainerRequest = specialists.activeRequests.trainer;
const validTabs = ['ai', 'manual', 'specialist'];
const requestedTab = Astro.url.searchParams.get('tab') ?? 'ai';
const activeTab = validTabs.includes(requestedTab) ? requestedTab : 'ai';
const errorMessage = readErrorMessage(Astro.url);
const invalidField = readInvalidField(Astro.url);
const saved = Astro.url.searchParams.get('saved');
const reused = Astro.url.searchParams.get('reused');
const historyDeleted = Astro.url.searchParams.get('historyDeleted');
const successMessage = saved === 'ai'
  ? 'Tu rutina IA quedó generada de lunes a domingo.'
  : saved === 'manual'
    ? 'Tu rutina manual quedó guardada.'
    : reused === 'ai'
      ? 'La rutina del historial volvió a quedar activa en Rutina IA.'
      : reused === 'manual'
        ? 'La rutina del historial volvió a quedar activa en Rutina manual.'
        : historyDeleted
          ? 'La rutina anterior se eliminó del historial.'
          : undefined;

const aiManagerDialog = 'routine-ai-manager-dialog';
const manualManagerDialog = 'routine-manual-manager-dialog';
const aiAutoDialog = activeTab === 'ai' && (errorMessage || historyDeleted === 'ai' || !automaticRoutine)
  ? aiManagerDialog
  : undefined;
const manualAutoDialog = activeTab === 'manual' && (errorMessage || historyDeleted === 'manual' || !manualRoutine)
  ? manualManagerDialog
  : undefined;
const aiManagerInitialTab = historyDeleted === 'ai' ? 'history' : 'generation';
const manualManagerInitialTab = historyDeleted === 'manual' ? 'history' : 'generation';
---

<ProtectedLayout
  title="Mi rutina"
  description="Rutinas con IA, manuales y asignadas por entrenador con formato semanal compatible."
  {user}
  currentPath={Astro.url.pathname}
  footerText="Roman Colosseum · Entrena con intención, registra tu progreso y recupera con paciencia."
>
  <PageIntro eyebrow="Planificación semanal" title="Entrenamiento" compact />

  <FormMessage message={successMessage} tone="success" />
  <FormMessage message={errorMessage} tone="error" />

  <nav class="routine-tabs" aria-label="Modalidades de rutina" role="tablist" data-routine-tabs>
    <a id="routine-tab-ai" href="?tab=ai" role="tab" aria-controls="routine-panel-ai" aria-selected={activeTab === 'ai' ? 'true' : 'false'} tabindex={activeTab === 'ai' ? 0 : -1} class:list={{ 'is-active': activeTab === 'ai' }} data-routine-tab="ai">
      <strong>Rutina IA</strong>
    </a>
    <a id="routine-tab-manual" href="?tab=manual" role="tab" aria-controls="routine-panel-manual" aria-selected={activeTab === 'manual' ? 'true' : 'false'} tabindex={activeTab === 'manual' ? 0 : -1} class:list={{ 'is-active': activeTab === 'manual' }} data-routine-tab="manual">
      <strong>Rutina manual</strong>
    </a>
    <a id="routine-tab-specialist" href="?tab=specialist" role="tab" aria-controls="routine-panel-specialist" aria-selected={activeTab === 'specialist' ? 'true' : 'false'} tabindex={activeTab === 'specialist' ? 0 : -1} class:list={{ 'is-active': activeTab === 'specialist' }} data-routine-tab="specialist">
      <strong>Rutina de especialista</strong>
    </a>
  </nav>

  <section id="routine-panel-ai" class="routine-panel" role="tabpanel" aria-labelledby="routine-tab-ai" hidden={activeTab !== 'ai'} data-routine-panel="ai" data-auto-dialog={aiAutoDialog}>
    {automaticRoutine ? (
      <>
        <div class="routine-plan-actions" aria-label="Acciones de rutina IA">
          <Button data-dialog-open={aiManagerDialog}>Generador y administrador de rutina</Button>
        </div>
        <div class="routine-result"><RoutineDocument plan={automaticRoutine} clientName={user.name} pdfHref="/api/routine/pdf/ai" /></div>
      </>
    ) : (
      <EmptyState title="Crea tu rutina IA" message="Configura objetivo, nivel, lugar, duración y días exactos de descanso.">
        <Button slot="actions" data-dialog-open={aiManagerDialog}>Generador y administrador de rutina</Button>
      </EmptyState>
    )}
  </section>

  <section id="routine-panel-manual" class="routine-panel" role="tabpanel" aria-labelledby="routine-tab-manual" hidden={activeTab !== 'manual'} data-routine-panel="manual" data-auto-dialog={manualAutoDialog}>
    {manualRoutine ? (
      <>
        <div class="routine-plan-actions" aria-label="Acciones de rutina manual">
          <Button data-dialog-open={manualManagerDialog}>Generador y administrador de rutina</Button>
        </div>
        <div class="routine-result"><RoutineDocument plan={manualRoutine} clientName={user.name} pdfHref="/api/routine/pdf/manual" /></div>
      </>
    ) : (
      <EmptyState title="Crea tu rutina manual" message="Define los parámetros generales y construye cada día de la semana.">
        <Button slot="actions" data-dialog-open={manualManagerDialog}>Generador y administrador de rutina</Button>
      </EmptyState>
    )}
  </section>

  <section id="routine-panel-specialist" class="routine-panel" role="tabpanel" aria-labelledby="routine-tab-specialist" hidden={activeTab !== 'specialist'} data-routine-panel="specialist">
    {specialistRoutine ? (
      <div class="routine-result routine-result--specialist"><RoutineDocument plan={specialistRoutine} clientName={user.name} authorName={trainerRequest?.specialistName} pdfHref="/api/routine/pdf/specialist" /></div>
    ) : trainerRequest?.status === 'accepted' ? (
      <EmptyState title="Tu entrenador aún no asigna una rutina" message={`${trainerRequest.specialistName} ya tiene acceso profesional para prepararla desde su lista de asesorados.`} />
    ) : trainerRequest?.status === 'pending' ? (
      <EmptyState title="Solicitud pendiente" message={`Cuando ${trainerRequest.specialistName} acepte tu solicitud podrá asignarte una rutina semanal.`} />
    ) : (
      <EmptyState title="Todavía no tienes entrenador asignado" message="Solicita un entrenador y espera su aceptación para habilitar esta modalidad."><Button slot="actions" href="/app/especialistas" size="small">Buscar entrenador</Button></EmptyState>
    )}
  </section>

  <AppDialog id={aiManagerDialog} class="routine-dialog" size="wide" title="Rutina IA" description="Genera, modifica o recupera tus planificaciones anteriores.">
    <div class="routine-manager" data-routine-manager data-initial-manager-tab={aiManagerInitialTab}>
      <nav class="routine-manager__tabs" aria-label="Administración de Rutina IA" role="tablist">
        <button type="button" role="tab" data-manager-tab="generation">Generación y administración</button>
        <button type="button" role="tab" data-manager-tab="history">Historial de rutinas <span>{automaticHistory.length}</span></button>
      </nav>
      <section data-manager-panel="generation">
        <AutomaticRoutineForm id="routine-ai-manager-form" plan={automaticRoutine} submitLabel={automaticRoutine ? 'Guardar nueva versión' : 'Generar rutina'} errorMessage={errorMessage} invalidField={invalidField} />
      </section>
      <section data-manager-panel="history" hidden>
        <RoutineHistory plans={automaticHistory} source="ai" />
      </section>
    </div>
  </AppDialog>

  <AppDialog id={manualManagerDialog} class="routine-dialog" size="wide" title="Rutina manual" description="Crea, modifica o recupera tus planificaciones anteriores.">
    <div class="routine-manager" data-routine-manager data-initial-manager-tab={manualManagerInitialTab}>
      <nav class="routine-manager__tabs" aria-label="Administración de Rutina manual" role="tablist">
        <button type="button" role="tab" data-manager-tab="generation">Generación y administración</button>
        <button type="button" role="tab" data-manager-tab="history">Historial de rutinas <span>{manualHistory.length}</span></button>
      </nav>
      <section class="routine-manager__child-panel" data-manager-panel="generation">
        <RoutinePlanEditor id="manual-routine-manager-form" action="/api/routine/manual/save" plan={manualRoutine} submitLabel={manualRoutine ? 'Guardar nueva versión' : 'Guardar rutina completa'} />
      </section>
      <section data-manager-panel="history" hidden>
        <RoutineHistory plans={manualHistory} source="manual" />
      </section>
    </div>
  </AppDialog>
</ProtectedLayout>

<script>
  import '../../scripts/routine-manager';
  import '../../scripts/routine-tabs';
</script>

<style>
  :global(.form-message) { margin-top: 1.4rem; }
  .routine-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.6rem, 2vw, 1.2rem); margin-top: 2.4rem; }
  .routine-tabs a { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 5.4rem; padding: 1rem clamp(.6rem, 2vw, 1.4rem); border: 1px solid var(--color-line); border-radius: 1.2rem; background: rgb(9 15 11 / 62%); color: var(--color-muted); text-align: center; transition: border-color var(--transition-fast), background var(--transition-fast), color var(--transition-fast), transform var(--transition-fast); }
  .routine-tabs strong { color: var(--color-paper); font-size: clamp(1.05rem, 1.6vw, 1.3rem); line-height: 1.25; letter-spacing: .06em; text-transform: uppercase; }
  .routine-tabs a:hover { border-color: rgb(214 166 66 / 58%); background: rgb(214 166 66 / 7%); transform: translateY(-.1rem); }
  .routine-tabs a.is-active { border-color: var(--color-gold); background: rgb(214 166 66 / 12%); box-shadow: inset 0 0 0 1px rgb(214 166 66 / 18%), 0 .8rem 2rem rgb(0 0 0 / 16%); }
  .routine-tabs a.is-active strong { color: var(--color-gold-light); }
  .routine-panel { margin-top: clamp(3rem, 6vw, 6rem); }
  .routine-plan-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.2rem; width: min(100%, 76rem); margin-inline: auto; }
  .routine-result { width: min(100%, 132rem); margin: clamp(4rem, 7vw, 7rem) auto; }
  .routine-result--specialist { margin-top: 0; }
  :global(.routine-dialog .dialog__surface) { overflow-x: hidden; }
  :global(.routine-dialog .dialog__body) { width: 100%; min-width: 0; max-width: 100%; padding-top: 2rem; }
  .routine-manager { display: grid; width: 100%; min-width: 0; max-width: 100%; gap: 1.8rem; }
  .routine-manager > section { min-width: 0; max-width: 100%; }
  .routine-manager__tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  .routine-manager__tabs button { display: flex; min-width: 0; min-height: 5rem; align-items: center; justify-content: center; gap: .8rem; padding: .9rem 1.2rem; border: 1px solid var(--color-line); border-radius: 1.2rem; background: rgb(9 15 11 / 62%); color: var(--color-paper); overflow-wrap: anywhere; font-size: 1.05rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
  .routine-manager__tabs button.is-active { border-color: var(--color-gold); background: rgb(214 166 66 / 13%); color: var(--color-gold-light); }
  .routine-manager__tabs span { display: grid; min-width: 2.3rem; height: 2.3rem; place-items: center; border-radius: 50%; background: rgb(214 166 66 / 16%); color: var(--color-gold-light); font-size: .95rem; }
  .routine-manager > section[hidden] { display: none; }
  .routine-manager__child-panel { width: 100%; min-width: 0; max-width: 100%; padding: clamp(1rem, 2.5vw, 1.8rem); border-top: .3rem solid var(--color-gold); background: linear-gradient(180deg, rgb(214 166 66 / 5%), rgb(6 11 8 / 28%)); }
  @media (max-width: 850px) {
    .routine-tabs { gap: .7rem; }
  }
  @media (max-width: 600px) {
    .routine-manager__tabs { grid-template-columns: 1fr; }
    .routine-manager__child-panel { padding: .8rem; }
    .routine-plan-actions { display: grid; }
    .routine-plan-actions :global(.button) { width: 100%; }
    .routine-result { margin-block: 4rem; }
  }
</style>
