---
import FieldRow from '../../components/forms/FieldRow.astro';
import FormField from '../../components/forms/FormField.astro';
import FormMessage from '../../components/forms/FormMessage.astro';
import FormStack from '../../components/forms/FormStack.astro';
import RoutineDocument from '../../components/routine/RoutineDocument.astro';
import RoutinePlanEditor from '../../components/routine/RoutinePlanEditor.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import Panel from '../../components/ui/Panel.astro';
import { ROUTINE_SESSION_DURATION_OPTIONS } from '../../domain/routine/routine';
import { getApplication } from '../../infrastructure/composition/container';
import ProtectedLayout from '../../layouts/ProtectedLayout.astro';
import { readErrorMessage, readInvalidField } from '../../presentation/feedback';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/iniciar-sesion');
const application = getApplication();
const [automaticRoutine, manualRoutine, specialistRoutine, specialists] = await Promise.all([
  application.getRoutinePlan(user.id, 'ai'),
  application.getRoutinePlan(user.id, 'manual'),
  application.getRoutinePlan(user.id, 'specialist'),
  application.getSpecialistsPage(user.id),
]);
const trainerRequest = specialists.activeRequests.trainer;
const validTabs = ['ai', 'manual', 'specialist'];
const requestedTab = Astro.url.searchParams.get('tab') ?? 'ai';
const activeTab = validTabs.includes(requestedTab) ? requestedTab : 'ai';
const errorMessage = readErrorMessage(Astro.url);
const invalidField = readInvalidField(Astro.url);
const saved = Astro.url.searchParams.get('saved');
const successMessage = saved === 'ai'
  ? 'Tu rutina automática quedó generada de lunes a domingo.'
  : saved === 'manual'
    ? 'Tu rutina manual quedó guardada.'
    : undefined;
const defaults = automaticRoutine ?? manualRoutine;
const selectedDuration = defaults?.sessionDurationMinutes ?? 60;
const durationOptions = ROUTINE_SESSION_DURATION_OPTIONS.includes(selectedDuration as never)
  ? [...ROUTINE_SESSION_DURATION_OPTIONS]
  : [...ROUTINE_SESSION_DURATION_OPTIONS, selectedDuration].sort((left, right) => left - right);
const durationOptionLabel = (minutes: number) => `${String(Math.floor(minutes / 60)).padStart(2, '0')} h ${String(minutes % 60).padStart(2, '0')} min`;
---

<ProtectedLayout
  title="Mi rutina"
  description="Rutinas automáticas, manuales y asignadas por entrenador con formato semanal compatible."
  {user}
  currentPath={Astro.url.pathname}
  footerText="Roman Colosseum · Entrena con intención, registra tu progreso y recupera con paciencia."
>
  <PageIntro
    eyebrow="Planificación semanal"
    title="Tu entrenamiento, de lunes a domingo"
    lead="Genera una rutina con IA, diseña la tuya o recibe una de tu entrenador. Las tres modalidades comparten ejercicios, series, repeticiones, descansos y PDF."
    compact
  />

  <FormMessage message={successMessage} tone="success" />
  <FormMessage message={errorMessage} tone="error" />

  <nav class="routine-tabs" aria-label="Modalidades de rutina" role="tablist" data-routine-tabs>
    <a id="routine-tab-ai" href="?tab=ai" role="tab" aria-controls="routine-panel-ai" aria-selected={activeTab === 'ai' ? 'true' : 'false'} tabindex={activeTab === 'ai' ? 0 : -1} class:list={{ 'is-active': activeTab === 'ai' }} data-routine-tab="ai">
      <span>01</span><strong>Rutina automática</strong><small>Personalizada con IA</small>
    </a>
    <a id="routine-tab-manual" href="?tab=manual" role="tab" aria-controls="routine-panel-manual" aria-selected={activeTab === 'manual' ? 'true' : 'false'} tabindex={activeTab === 'manual' ? 0 : -1} class:list={{ 'is-active': activeTab === 'manual' }} data-routine-tab="manual">
      <span>02</span><strong>Rutina manual</strong><small>Diseñada por ti</small>
    </a>
    <a id="routine-tab-specialist" href="?tab=specialist" role="tab" aria-controls="routine-panel-specialist" aria-selected={activeTab === 'specialist' ? 'true' : 'false'} tabindex={activeTab === 'specialist' ? 0 : -1} class:list={{ 'is-active': activeTab === 'specialist' }} data-routine-tab="specialist">
      <span>03</span><strong>Rutina de especialista</strong><small>Asignada por entrenador</small>
    </a>
  </nav>

  <section id="routine-panel-ai" class="routine-panel" role="tabpanel" aria-labelledby="routine-tab-ai" hidden={activeTab !== 'ai'} data-routine-panel="ai">
    <div class="automatic-planner">
      <Panel labelledby="automatic-routine-title">
        <p class="eyebrow">Generación personalizada</p>
        <h2 id="automatic-routine-title">Configura tu semana</h2>
        <FormStack action="/api/routine/automatic/generate" data-ai-routine-form>
          <FieldRow>
            <FormField label="Objetivo de entrenamiento" for="routine-goal" required error={invalidField === 'goal' ? errorMessage : undefined}>
              <select id="routine-goal" name="goal" required>
                <option value="fuerza" selected={defaults?.goal === 'fuerza'}>Ganar fuerza</option>
                <option value="hipertrofia" selected={!defaults || defaults.goal === 'hipertrofia'}>Hipertrofia / masa muscular</option>
                <option value="perdida_grasa" selected={defaults?.goal === 'perdida_grasa'}>Pérdida de grasa</option>
                <option value="resistencia" selected={defaults?.goal === 'resistencia'}>Resistencia</option>
                <option value="movilidad" selected={defaults?.goal === 'movilidad'}>Movilidad</option>
                <option value="general" selected={defaults?.goal === 'general'}>Condición física general</option>
              </select>
            </FormField>
            <FormField label="Nivel" for="routine-level" required error={invalidField === 'level' ? errorMessage : undefined}>
              <select id="routine-level" name="level" required>
                <option value="principiante" selected={!defaults || defaults.level === 'principiante'}>Principiante</option>
                <option value="intermedio" selected={defaults?.level === 'intermedio'}>Intermedio</option>
                <option value="avanzado" selected={defaults?.level === 'avanzado'}>Avanzado</option>
              </select>
            </FormField>
          </FieldRow>
          <FieldRow>
            <FormField label="Lugar de entrenamiento" for="routine-location" required error={invalidField === 'location' ? errorMessage : undefined}>
              <select id="routine-location" name="location" required>
                <option value="gimnasio" selected={!defaults || defaults.location === 'gimnasio'}>Gimnasio</option>
                <option value="casa" selected={defaults?.location === 'casa'}>Casa</option>
                <option value="mixto" selected={defaults?.location === 'mixto'}>Mixto</option>
              </select>
            </FormField>
            <FormField label="Duración por sesión" for="routine-duration" hint="Selecciona una duración en horas y minutos." required error={invalidField === 'sessionDurationMinutes' ? errorMessage : undefined}>
              <select id="routine-duration" name="sessionDurationMinutes" required>
                {durationOptions.map((minutes) => <option value={minutes} selected={minutes === selectedDuration}>{durationOptionLabel(minutes)}</option>)}
              </select>
            </FormField>
          </FieldRow>
          <FormField label="Días de descanso, lunes a domingo" for="routine-rest" hint="Puedes entrenar el domingo o marcarlo como descanso." required error={invalidField === 'restDays' ? errorMessage : undefined}>
            <input id="routine-rest" name="restDaysCount" type="number" min="0" max="6" step="1" required value={defaults?.days.filter((day) => day.isRestDay).length ?? 2} />
          </FormField>
          <FormField label="Limitaciones o consideraciones" for="routine-limitations" hint="No se utiliza para diagnóstico ni rehabilitación.">
            <textarea id="routine-limitations" name="limitations" maxlength="500" rows="3" placeholder="Ej. Prefiero ejercicios de bajo impacto">{defaults?.limitations ?? ''}</textarea>
          </FormField>
          <Button type="submit" data-ai-routine-submit>{automaticRoutine ? 'Regenerar rutina' : 'Generar mi rutina'}</Button>
        </FormStack>
      </Panel>
      <aside class="week-specification">
        <p class="eyebrow">Formato del documento</p><h2>Semana compatible</h2>
        <ol><li><strong>7 días visibles</strong><span>Lunes a domingo</span></li><li><strong>Grupos cubiertos</strong><span>Ejercicios para cada grupo anunciado</span></li><li><strong>Prescripción adecuada</strong><span>Repeticiones o tiempo según el ejercicio</span></li><li><strong>PDF real</strong><span>Misma información de pantalla</span></li></ol>
      </aside>
    </div>
    <div class="routine-result">
      {automaticRoutine ? <RoutineDocument plan={automaticRoutine} clientName={user.name} pdfHref="/api/routine/pdf/ai" /> : <EmptyState title="Tu rutina automática aparecerá aquí" message="Selecciona objetivo, descansos, duración y nivel para crear una semana completa." />}
    </div>
  </section>

  <section id="routine-panel-manual" class="routine-panel" role="tabpanel" aria-labelledby="routine-tab-manual" hidden={activeTab !== 'manual'} data-routine-panel="manual">
    <header class="panel-intro"><p class="eyebrow">Tu propia programación</p><h2>Rutina manual</h2><p>Define cada día, descanso y ejercicio con la misma estructura que utiliza la IA y el entrenador.</p></header>
    <details class="editor-disclosure" open={!manualRoutine}>
      <summary>{manualRoutine ? 'Editar mi rutina manual' : 'Crear mi rutina manual'}</summary>
      <div class="editor-disclosure__content"><RoutinePlanEditor id="manual-routine-editor" action="/api/routine/manual/save" plan={manualRoutine} submitLabel="Guardar mi rutina" /></div>
    </details>
    {manualRoutine && <div class="routine-result routine-result--existing"><RoutineDocument plan={manualRoutine} clientName={user.name} pdfHref="/api/routine/pdf/manual" /></div>}
  </section>

  <section id="routine-panel-specialist" class="routine-panel" role="tabpanel" aria-labelledby="routine-tab-specialist" hidden={activeTab !== 'specialist'} data-routine-panel="specialist">
    <header class="panel-intro"><p class="eyebrow">Seguimiento profesional</p><h2>Rutina de especialista</h2><p>Solo el entrenador cuya solicitud fue aceptada puede crear o actualizar este documento.</p></header>
    {specialistRoutine ? (
      <RoutineDocument plan={specialistRoutine} clientName={user.name} authorName={trainerRequest?.specialistName} pdfHref="/api/routine/pdf/specialist" />
    ) : trainerRequest?.status === 'accepted' ? (
      <EmptyState title="Tu entrenador aún no asigna una rutina" message={`${trainerRequest.specialistName} ya tiene acceso profesional para prepararla desde su lista de asesorados.`} />
    ) : trainerRequest?.status === 'pending' ? (
      <EmptyState title="Solicitud pendiente" message={`Cuando ${trainerRequest.specialistName} acepte tu solicitud podrá asignarte una rutina semanal.`} />
    ) : (
      <EmptyState title="Todavía no tienes entrenador asignado" message="Solicita un entrenador y espera su aceptación para habilitar esta modalidad."><Button slot="actions" href="/app/especialistas" size="small">Buscar entrenador</Button></EmptyState>
    )}
  </section>
</ProtectedLayout>

<script>
  import '../../scripts/routine-tabs';
  const form = document.querySelector<HTMLFormElement>('[data-ai-routine-form]');
  form?.addEventListener('submit', () => {
    const button = form.querySelector<HTMLButtonElement>('[data-ai-routine-submit]');
    const status = form.querySelector<HTMLElement>('[data-ai-routine-status]');
    if (button) { button.disabled = true; button.textContent = 'Generando semana...'; }
    if (status) status.textContent = 'Estamos organizando sesiones, descansos y progresiones.';
  });
</script>

<style>
  :global(.form-message) { margin-top: 1.4rem; }
  .routine-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 3rem; border: 1px solid var(--color-line); background: rgb(9 15 11 / 62%); }
  .routine-tabs a { display: grid; grid-template-columns: auto 1fr; column-gap: 1rem; padding: 1.6rem; border-right: 1px solid var(--color-line); color: var(--color-muted); transition: background var(--transition-fast), color var(--transition-fast); }
  .routine-tabs a:last-child { border-right: 0; }
  .routine-tabs a > span { grid-row: 1 / 3; color: var(--color-gold); font: 700 1.8rem var(--font-display); }
  .routine-tabs strong { color: var(--color-paper); font-size: 1.3rem; letter-spacing: .07em; text-transform: uppercase; }
  .routine-tabs small { font-size: 1.15rem; }
  .routine-tabs a:hover, .routine-tabs a.is-active { background: rgb(214 166 66 / 9%); }
  .routine-tabs a.is-active { box-shadow: inset 0 -.3rem var(--color-gold); }
  .routine-tabs a.is-active strong, .routine-tabs a.is-active small { color: var(--color-gold-light); }
  .routine-panel { margin-top: 2rem; }
  .automatic-planner { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(27rem, .75fr); gap: 1.6rem; }
  .automatic-planner h2, .week-specification h2 { margin: .3rem 0 1.5rem; font: 700 2.6rem var(--font-display); }
  .week-specification { align-self: start; padding: 2rem; border: 1px solid var(--color-line); background: linear-gradient(150deg, rgb(214 166 66 / 8%), rgb(18 27 21 / 98%)); }
  .week-specification ol { display: grid; gap: .8rem; margin: 0; padding: 0; list-style: none; }
  .week-specification li { display: grid; padding: 1rem; border: 1px solid var(--color-line-soft); }
  .week-specification strong { color: var(--color-gold-light); }
  .week-specification span { color: var(--color-muted); font-size: 1.2rem; }
  .routine-result { margin-top: 2rem; }
  .routine-result--existing { margin: 2rem 0 0; }
  .panel-intro { max-width: 78rem; padding: 1.2rem 0 2rem; }
  .panel-intro h2 { margin: 0; font: 700 clamp(3rem, 5vw, 4.5rem) var(--font-display); }
  .panel-intro > p:last-child { color: var(--color-muted); }
  .editor-disclosure { border: 1px solid var(--color-line); }
  .editor-disclosure > summary { padding: 1.5rem 1.8rem; background: rgb(214 166 66 / 7%); color: var(--color-gold-light); cursor: pointer; font-size: 1.2rem; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; }
  .editor-disclosure__content { padding: 1.6rem; border-top: 1px solid var(--color-line); }
  @media (max-width: 850px) {
    .routine-tabs, .automatic-planner { grid-template-columns: 1fr; }
    .routine-tabs a { border-right: 0; border-bottom: 1px solid var(--color-line); }
    .routine-tabs a:last-child { border-bottom: 0; }
    .routine-tabs a.is-active { box-shadow: inset .3rem 0 var(--color-gold); }
  }
  @media (max-width: 600px) { .editor-disclosure__content { padding: .8rem; } }
</style>
