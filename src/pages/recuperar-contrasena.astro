---
import AuthCard from '../components/auth/AuthCard.astro';
import FormField from '../components/forms/FormField.astro';
import FormMessage from '../components/forms/FormMessage.astro';
import FormStack from '../components/forms/FormStack.astro';
import Button from '../components/ui/Button.astro';
import AuthLayout from '../layouts/AuthLayout.astro';
import { readErrorMessage, readInvalidField } from '../presentation/feedback';

const errorMessage = readErrorMessage(Astro.url);
const invalidField = readInvalidField(Astro.url);
const sent = Astro.url.searchParams.has('sent');
---

<AuthLayout title="Recuperar contraseña" description="Solicita un enlace seguro para volver a entrar a tu cuenta.">
  <AuthCard title="Recupera tu acceso" description="Escribe el correo de tu cuenta y te enviaremos un enlace para crear una nueva contraseña.">
    {sent ? (
      <FormMessage tone="success" message="Si existe una cuenta con ese correo, recibirás un enlace para restablecer la contraseña. Revisa también la carpeta de spam." />
    ) : (
      <FormStack action="/api/auth/password-reset/request" autocomplete="on">
        <FormField label="Correo electrónico" for="recovery-email" required error={invalidField === 'email' ? errorMessage : undefined}>
          <input id="recovery-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-invalid={invalidField === 'email' ? 'true' : undefined} />
        </FormField>
        <FormMessage message={invalidField ? undefined : errorMessage} tone="error" />
        <Button type="submit">Enviar enlace</Button>
      </FormStack>
    )}
    <Fragment slot="footer"><a href="/iniciar-sesion">Volver a iniciar sesión</a>.</Fragment>
  </AuthCard>
</AuthLayout>
