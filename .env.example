# Entorno general. No incluyas secretos reales en este archivo.
NODE_ENV=development
APP_ORIGIN=http://localhost:4321

# Acceso temporal: demo | authenticated
# demo oculta login/registro y usa un perfil compartido. No lo uses en producción pública.
APP_ACCESS_MODE=demo

# Persistencia inicial en un archivo privado del servidor.
# No uses una ruta dentro de public/ ni una ubicación versionada por Git.
DATA_FILE_PATH=.data/roman-colosseum.json
UPLOADS_DIRECTORY=.data/uploads

# Acceso disponible: password habilita credenciales locales; google conserva
# las credenciales locales y añade el botón de Google. Firebase sigue reservado.
AUTH_PROVIDER=password

# Siete días, expresados en segundos.
SESSION_TTL_SECONDS=604800

# Recuperación de contraseña mediante API HTTPS (Railway Hobby bloquea SMTP).
# Opción inicial sin dominio: crea una cuenta gratuita Brevo, verifica tu correo remitente
# y coloca su API key y esa dirección en estas variables. Brevo puede reemplazar el remitente visible.
# Sin clave y remitente, el formulario indicará que la recuperación no está disponible.
BREVO_API_KEY=
RECOVERY_EMAIL_FROM=
# Alternativa futura con dominio propio verificado; si ambas claves existen, se usa Brevo.
RESEND_API_KEY=

# Generación opcional de dietas con IA. La clave permanece exclusivamente en servidor.
# Sin clave, la aplicación utiliza el motor automático local y lo indica en el plan.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Google Identity Services. Solo es obligatorio cuando AUTH_PROVIDER=google.
PUBLIC_GOOGLE_CLIENT_ID=

# Firebase Web SDK. Estos identificadores pueden llegar al cliente, pero no autorizan por sí solos.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Firebase Admin / Firestore. La cuenta de servicio es un secreto exclusivo del servidor.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_DATABASE_ID=
